# Clerk publishable key — MUST be the same Clerk instance as the Ringee web app
# so the extension shares the signed-in session via syncHost.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# The web app origin the extension syncs its Clerk session from.
VITE_CLERK_SYNC_HOST="https://app.ringee.io"

# Ringee backend API base (include the /api global prefix).
VITE_RINGEE_API_URL="https://api.ringee.io/api"

# Default region for numbers detected without a country code (ISO alpha-2).
VITE_DEFAULT_REGION="US"

# Optional static Telnyx WebRTC credentials + public caller ID — the same shared
# credentials the web app uses (NEXT_PUBLIC_TELNYX_LOGIN / _PASSWORD /
# NEXT_PUBLIC_RINGEE_PUBLIC_CALLER_ID). When set, the extension dials with these
# instead of the backend-minted ephemeral credentials (and falls back to them if
# the backend prepare-call is unavailable). Leave unset to always use the
# backend's per-call credentials.
# VITE_TELNYX_LOGIN=""
# VITE_TELNYX_PASSWORD=""
# VITE_RINGEE_PUBLIC_CALLER_ID=""

# Base64 public key that pins a STABLE extension ID. Required so the
# `chrome-extension://<id>` origin you register in Clerk's allowed_origins stays
# valid (an unpinned ID changes per machine/install). The value is public — safe
# to commit. Generate your own keypair + ID:
#   openssl genrsa 2048 > key.pem                                   # private (keep secret, gitignored)
#   openssl rsa -in key.pem -pubout -outform DER | openssl base64 -A  # → CRX_KEY value below
#   openssl rsa -in key.pem -pubout -outform DER | shasum -a 256 | head -c 32 | tr 0-9a-f a-p  # → extension ID
# CRX_KEY=""
