{
  "name": "browser-extension",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Ringee browser extension — modern, low-cost outbound dialing. Call any number on any page with the real Ringee dialer over WebRTC.",
  "scripts": {
    "dev": "node scripts/dev-watch.mjs",
    "build": "vite build",
    "package": "node scripts/pack.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^2.5.0",
    "@ringee/dialer-core": "workspace:*",
    "@ringee/dialer-ui": "workspace:*",
    "@ringee/frontend-shared": "workspace:*",
    "@telnyx/webrtc": "2.25.2",
    "country-flag-icons": "^1.5.21",
    "lucide-react": "^0.476.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-phone-number-input": "3.3.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
