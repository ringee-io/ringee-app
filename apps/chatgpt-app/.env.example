# =====================================================================
# Ringee ChatGPT App — environment
#
# Two distinct servers are involved:
#   1. api.ringee.io        → the Ringee backend/MCP (source of truth).
#                             This app FORWARDS to it; never duplicates logic.
#   2. THIS app's MCP server → standalone server (serve.ts, :4250) that
#                             ChatGPT connects to. It lives on its OWN host,
#                             NOT on api.ringee.io.
#
# Pick ONE mode below: PRODUCTION (multi-tenant OAuth) or DEV (single account).
# =====================================================================


# ── THIS app's MCP server (what ChatGPT connects to) ───────────────────
RINGEE_MCP_PORT=4250

# Canonical public HTTPS URL of THIS server (the OAuth "resource"/audience).
# Set this to wherever you DEPLOY this app — change if you use another host.
RINGEE_PUBLIC_URL=https://chatgpt.ringee.io

# Where widgets/assets are served (defaults to http://localhost:4202 in dev).
# In production it's the same host as RINGEE_PUBLIC_URL (widgets are inlined).
RINGEE_APP_URL=https://chatgpt.ringee.io

# Where the built widget bundle lives (defaults to ./dist/widgets).
# RINGEE_WIDGETS_DIR=


# ── Upstream Ringee backend = your API (source of truth) ───────────────
# Used in multi-tenant mode: the app forwards the caller's OAuth token to
# ${RINGEE_BACKEND_URL}/api/mcp/chatgpt/sse, which maps it to the account.
RINGEE_BACKEND_URL=https://api.ringee.io


# ── PRODUCTION — OAuth 2.1 (multi-tenant; required to publish) ─────────
# Each customer signs in with their own Ringee/Clerk account; the verified
# Bearer token is forwarded to the backend's authenticated MCP endpoint.
RINGEE_REQUIRE_AUTH=true
# Clerk issuer = the Frontend API domain (NOT the accounts.* portal UI).
# Needed so the protected-resource metadata can point ChatGPT at Clerk.
RINGEE_OAUTH_ISSUER=https://clerk.ringee.io

# ChatGPT is an OIDC client and ALWAYS requests "openid" (it adds it itself,
# regardless of what we advertise). So advertise it too. The catch: ChatGPT
# auto-registers its client via Clerk's Dynamic Client Registration, and Clerk
# grants DCR clients only "profile email offline_access" by DEFAULT — NOT
# "openid" — which makes the authorize fail with:
#   invalid_scope "client is not allowed to request scope 'openid'".
# FIX is on the CLERK side: allow DCR-registered clients to request "openid"
# (Clerk Dashboard → OAuth Applications / Dynamic Client Registration → default
# scopes), then re-create the ChatGPT connector so it does a fresh DCR.
RINGEE_OAUTH_SCOPES=profile email offline_access

# JWKS / AUDIENCE — only used for the OPTIONAL local fast-fail verification in
# the proxy. With Clerk's OAuth tokens we DELEGATE verification to the backend
# (Clerk verifies + maps the token to the account), so leave these UNSET:
#   - Clerk does not set aud to RINGEE_PUBLIC_URL (no resource indicators), so a
#     local audience check would reject valid tokens.
# To re-enable strict local checks once confirmed, set JWKS and (optionally) a
# matching audience. With both unset, serve.ts forwards the token as-is.
# RINGEE_OAUTH_JWKS_URL=https://clerk.ringee.io/.well-known/jwks.json
# RINGEE_OAUTH_AUDIENCE=https://chatgpt.ringee.io

# NOTE: local verification (when JWKS is set) requires the `jose` dependency.


# ── DEV — single account, no OAuth (local only) ───────────────────────
# To run locally, set RINGEE_REQUIRE_AUTH=false above and use the per-user
# SSE URL from the dashboard (Settings → MCP / Integrations). In this mode
# RINGEE_BACKEND_URL / OAuth vars are NOT used.
# RINGEE_REQUIRE_AUTH=false
# RINGEE_MCP_URL=https://api.ringee.io/api/mcp/<yourUserId>/sse
# RINGEE_APP_URL=http://localhost:4202
# Optional bearer token forwarded to the backend.
# RINGEE_API_KEY=
