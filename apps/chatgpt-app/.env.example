# ── Ringee connection (the backend/MCP is the source of truth) ──────────
# Preferred: the full MCP SSE URL from the dashboard
# (Settings → MCP / Integrations → GET /api/mcp/connection-info).
RINGEE_MCP_URL=

# Or let the agent layer build the URL:
# RINGEE_BACKEND_URL=https://api.ringee.io
# RINGEE_USER_ID=
# RINGEE_ORG_ID=

# Optional bearer token forwarded to the backend.
# RINGEE_API_KEY=

# ── MCP server (serve.ts) — what ChatGPT connects to ───────────────────
RINGEE_MCP_PORT=4250
# Canonical public HTTPS URL of THIS server (used in OAuth metadata).
RINGEE_PUBLIC_URL=http://localhost:4250
# Where the built widget bundle lives (defaults to ./dist/widgets).
# RINGEE_WIDGETS_DIR=

# ── OAuth 2.1 (production; opt-in) ─────────────────────────────────────
# Turn on to require a verified Bearer token on /mcp.
RINGEE_REQUIRE_AUTH=false
# Your identity provider (issuer + JWKS). Needed when auth is enabled.
# RINGEE_OAUTH_ISSUER=https://auth.ringee.io
# RINGEE_OAUTH_JWKS_URL=https://auth.ringee.io/.well-known/jwks.json
# RINGEE_OAUTH_AUDIENCE=https://app.ringee.io/mcp
# RINGEE_OAUTH_SCOPES=ringee:use
