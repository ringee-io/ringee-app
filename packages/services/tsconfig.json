{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "noEmit": false
  },

  /* The root config's "dist" resolves against the root, not this package, so
     the build output here would otherwise be type-checked as source. */
  "exclude": ["node_modules", "dist"]
}
