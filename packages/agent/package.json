{
  "name": "@ringee-io/agent",
  "version": "0.1.0",
  "description": "Agent layer for Ringee — typed clients, schemas, flows, prompts and operating rules on top of the existing Ringee backend/MCP. Powers the `ringee` CLI, Claude Skills (Claude Code + claude.ai) and the ChatGPT App. Contains NO business logic of its own: the Ringee backend/MCP is the single source of truth.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./clients": "./src/clients/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./types": "./src/types/index.ts",
    "./flows": "./src/flows/index.ts",
    "./prompts": "./src/prompts/index.ts",
    "./rules": "./src/rules/index.ts",
    "./tools": "./src/tools/index.ts",
    "./config": "./src/config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm run clean",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "install-skills": "node scripts/install-skills.mjs",
    "package-skills": "node scripts/package-skills.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "~22.16.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
