// ── Call Sessions ──
// A CallSession is a queue of contacts/phone numbers to call. It can be
// shared via a magic-link access token so an unauthenticated collaborator
// can step through the queue and capture outcomes per call.

model CallSession {
  id             String  @id @default(uuid()) @db.Uuid
