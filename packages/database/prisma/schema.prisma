// ── TriggerLoop integration ──
// Ringee is the action executor for TriggerLoop workflows. These three tables
// make the integration safe under retries, partial failures, and temporary
// unavailability of the TriggerLoop engine.

// One row per (workflowInstanceId, actionKey). Consulted on executeAction to
// return a cached result instead of re-running the handler. `allowRepeat=true`
// actions bypass this check at the service layer (key is suffixed per call).
model TriggerLoopActionExecution {
  id                 String   @id @default(uuid()) @db.Uuid
  workflowInstanceId String
  actionKey          String
  actionType         String
  workflowKey        String
  subjectType        String
  subjectId          String
  success            Boolean  @default(false)
  externalReference  String?
  errorMessage       String?  @db.Text
  attemptCount       Int      @default(1)
  payload            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([workflowInstanceId, actionKey])
  @@index([subjectId])
  @@index([workflowKey])
}

// Durable outbox for outbound TriggerLoop calls. `TriggerLoopEventPublisher`
// attempts immediate send; on failure the payload lands here and the worker
// drains it with exponential backoff.
model TriggerLoopOutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  kind          String // "event" | "startWorkflow" | "cancelWorkflow"
  endpoint      String // HTTP path used by the client
  payload       Json // full request body
  status        String    @default("pending") // "pending" | "sent" | "failed"
  attemptCount  Int       @default(0)
  lastError     String?   @db.Text
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// Per-user derived activity state. Source of truth for "has the user ever
// had a first call", "when did they last do something", and "did we already
// tell TriggerLoop about the current inactive phase". Transition-emission
// events (call.firstCompleted, user.becameActive, user.inactive) all read
// and update this table to stay idempotent.
model UserActivitySnapshot {
  userId                String    @id @db.Uuid
  firstCallCompletedAt  DateTime?
  firstCallEmittedAt    DateTime?
  lastActiveAt          DateTime?
  lastActiveEmittedAt   DateTime?
  lastInactiveEmittedAt DateTime?
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastActiveAt])
  @@index([lastInactiveEmittedAt])
}

// ── CRM Integration Models ──
// Provider-agnostic tables. Attio is the first provider; HubSpot/Salesforce
// slot in without schema changes. Visibility & ownership mirror the rest of
// Ringee (personal = organizationId null, organization = organizationId set).

model CrmConnection {
  id             String             @id @default(uuid()) @db.Uuid
  provider       CrmProviderType
  scope          CrmConnectionScope
  userId         String             @db.Uuid
  organizationId String?            @db.Uuid

  externalAccountId   String
  externalAccountName String?

  accessTokenCiphertext  String    @db.Text
  refreshTokenCiphertext String?   @db.Text
  tokenExpiresAt         DateTime?
  scopes                 String[]

  status        CrmConnectionStatus @default(active)
  lastErrorCode String?
  lastErrorAt   DateTime?
  lastSyncAt    DateTime?

  providerMetadata Json?
  capabilities     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  callSyncs     CrmCallSync[]
  contactLinks  CrmContactLink[]
  companyLinks  CrmCompanyLink[]
  fieldMappings CrmFieldMapping[]

  @@unique([scope, organizationId, provider])
  @@unique([scope, userId, provider, organizationId])
  @@index([provider, status])
  @@index([userId])
  @@index([organizationId])
}

model CrmContactLink {
  id              String          @id @default(uuid()) @db.Uuid
  connectionId    String          @db.Uuid
  contactId       String?         @db.Uuid
  provider        CrmProviderType
  externalId      String
  externalType    CrmRecordType
  phoneNumberE164 String

  matchConfidence String   @default("phone_exact")
  lastSyncedAt    DateTime @default(now())
  rawSnapshot     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalType, externalId])
  @@unique([connectionId, phoneNumberE164])
  @@index([contactId])
  @@index([phoneNumberE164])
}

model CrmCallSync {
  id           String          @id @default(uuid()) @db.Uuid
  connectionId String          @db.Uuid
  provider     CrmProviderType
  callId       String          @db.Uuid

  externalActivityId String?
  externalRecordId   String?
  externalRecordType CrmRecordType?

  status        CrmSyncStatus @default(pending)
  attemptCount  Int           @default(0)
  lastError     String?       @db.Text
  nextAttemptAt DateTime?

  idempotencyKey  String
  payloadSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  call       Call          @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([connectionId, callId])
  @@unique([idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([callId])
  @@index([connectionId])
}

model CrmOutboxEvent {
  id           String          @id @default(uuid()) @db.Uuid
  connectionId String?         @db.Uuid
  provider     CrmProviderType
  kind         String
  subjectId    String?
  payload      Json

  status        CrmOutboxStatus @default(pending)
  attemptCount  Int             @default(0)
  lastError     String?         @db.Text
  nextAttemptAt DateTime        @default(now())
  processedAt   DateTime?

  dedupeKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([provider])
  @@index([connectionId])
}

model CrmFieldMapping {
  id             String          @id @default(uuid()) @db.Uuid
  connectionId   String          @db.Uuid
  provider       CrmProviderType
  ringeeEntity   String
  ringeeField    String
  externalEntity String
  externalField  String
  transform      Json?
  direction      String          @default("push")
