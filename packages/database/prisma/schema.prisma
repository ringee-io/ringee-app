// Magic-link tokens are stored as opaque high-entropy strings. The raw value
// is shown to the caller once at issue time; we only persist tokenHash.
model CallSessionAccessToken {
  id            String @id @default(uuid()) @db.Uuid
  callSessionId String @db.Uuid

  tokenHash String                       @unique
  type      CallSessionAccessTokenType   @default(magic_link)
