generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  pending
  verified
  unverified
}

enum CallStatus {
  pending
  ringing
  answered
  recording
  completed
  failed
}

enum CallOutcome {
  meeting_booked
  sale
  interested
  follow_up
  not_interested
  no_answer
  voicemail
  wrong_number
  gatekeeper
}

enum CalendarProvider {
  google
  microsoft
}

enum MeetingStatus {
  scheduled
  completed
  cancelled
  rescheduled
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  incomplete
}

// ── Outbound System Enums ──

enum DialerMode {
  progressive
  preview
}

enum CampaignLeadStatus {
  pending
  queued
  locked
  dialing
  in_call
  wrap_up
  dispositioned
  scheduled
  completed
  exhausted
  dnc
}

enum AgentSessionStatus {
  ready
  reserved
  dialing
  in_call
  wrap_up
  paused
  offline
}

enum CallAttemptStatus {
  created
  dialing
  ringing
  answered
  in_call
  ended
  dispositioned
}

enum DispositionCategory {
  positive
  neutral
  negative
  no_contact
}

enum CallbackStatus {
  scheduled
  due
  in_progress
  completed
  missed
  cancelled
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  clerkId          String?  @unique
  firstName        String?
  lastName         String?
  imageUrl         String?
  profileImageUrl  String?
  passwordEnabled  Boolean? @default(false)
  twoFactorEnabled Boolean? @default(false)
  publicMetadata   Json?
  privateMetadata  Json?
  unsafeMetadata   Json?
  clientIp         String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customerId       String?
  freeCallTrial    Boolean? @default(true)
  encryptionKey    String?  @db.Text

  // Onboarding state
  onboardingCompletedSteps String[]  @default([])
  onboardingDismissedAt    DateTime?

  emails                  UserEmail[]
  chatAuths               ChatAuth[]
  calls                   Call[]
  numbersOwned            NumberPurchased[]
  userNumbers             UserNumber[]
  Contact                 Contact[]
  ContactNote             ContactNote[]
  CallerId                CallerId[]
  Credit                  Credit[]
  creditAutoReload        CreditAutoReload?
  devices                 UserDevice[]
  organizationMemberships OrganizationMembership[]
  subscriptions           Subscription[]
  campaigns               Campaign[]
  campaignMembers         CampaignMember[]
  campaignLeads           CampaignLead[]
  tags                    Tag[]
  meetings                Meeting[]
  calendarIntegrations    CalendarIntegration[]

  @@index([clerkId])
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  clerkId       String   @unique
  name          String
  slug          String?  @unique
  imageUrl      String?
  customerId    String? // Stripe customer ID for B2B billing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  encryptionKey String?  @db.Text

  members              OrganizationMembership[]
  chatAuths            ChatAuth[]
  calls                Call[]
  userNumbers          UserNumber[]
  numbersPurchased     NumberPurchased[]
  contacts             Contact[]
  callerIds            CallerId[]
  credits              Credit[]
  creditAutoReload     CreditAutoReload?
  subscriptions        Subscription[]
  campaigns            Campaign[]
  tags                 Tag[]
  meetings             Meeting[]
  calendarIntegrations CalendarIntegration[]

  @@index([clerkId])
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  clerkUserId    String? // Clerk user ID for pending invitations
  role           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, clerkUserId])
  @@index([organizationId])
  @@index([userId])
  @@index([clerkUserId])
}

model UserEmail {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  email     String      @unique
  isPrimary Boolean     @default(false)
  status    EmailStatus @default(pending)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model ChatAuth {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  phoneNumber    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([phoneNumber])
  @@index([organizationId])
}

model DeletedUser {
  id               String    @id @default(uuid()) @db.Uuid
  originalUserId   String?   @db.Uuid
  clerkId          String?
  firstName        String?
  lastName         String?
  imageUrl         String?
  profileImageUrl  String?
  passwordEnabled  Boolean?
  twoFactorEnabled Boolean?
  publicMetadata   Json?
  privateMetadata  Json?
  unsafeMetadata   Json?
  clientIp         String?
  userAgent        String?
  deletionReason   String?
  deletedBy        String?
  deletedAt        DateTime  @default(now())
  createdAt        DateTime?
  updatedAt        DateTime?

  emails    Json?
  chatAuths Json?

  notes String?

  @@index([originalUserId])
  @@index([clerkId])
}

model Call {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @db.Uuid
  organizationId  String?    @db.Uuid
  providerCallId  String?    @unique
  connectionId    String?
  callControlId   String?    @unique
  callSessionId   String?
  callLegId       String?
  fromNumber      String
  toNumber        String
  direction       String?
  status          CallStatus @default(pending)
  durationSeconds Int?
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  totalCost       Float?
  costMeta        Json?
  contactId       String?    @db.Uuid
  contact         Contact?   @relation(fields: [contactId], references: [id])

  callerIdId String?   @db.Uuid
  callerId   CallerId? @relation(fields: [callerIdId], references: [id])

  clientState   String?
  lastCommandId String?
  lastEventType String?
  errorMessage  String?
  directionMeta Json?

  outcome     CallOutcome?
  outcomeNote String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization  Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  transcription CallTranscriptionSegment[]
  recordings    Recording[]
  meetings      Meeting[]
  callAttempts  CallAttempt[]

  @@index([userId])
  @@index([organizationId])
  @@index([callControlId])
  @@index([callSessionId])
  @@index([fromNumber])
  @@index([toNumber])
}

model CallTranscriptionSegment {
  id        String   @id @default(uuid())
  callId    String   @db.Uuid
  text      String
  speaker   Int?
  track     String?
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id])
}

model TelnyxRatePerMinute {
  id                  String   @id @default(uuid()) @db.Uuid
  iso                 String   @db.VarChar(10)
  country             String
  originationPrefixes String?  @db.Text
  destinationPrefixes String?  @db.Text
  description         String?  @db.Text
  interval1           Int?     @map("interval_1")
  intervalN           Int?     @map("interval_n")
  rate                Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([iso])
  @@index([country])
}

model UserNumber {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String?  @db.Uuid
  numberId       String   @db.Uuid
  isPrimary      Boolean  @default(false)
  canCall        Boolean  @default(true)
  canReceive     Boolean  @default(true)
  canRecord      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  enabled        Boolean  @default(false)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  numberPurchased NumberPurchased @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([userId, numberId, enabled])
  @@index([numberId])
  @@index([userId])
  @@index([organizationId])
}

model NumberPurchased {
  id                     String    @id @default(uuid()) @db.Uuid
  phoneNumber            String    @unique
  isoCountry             String    @db.VarChar(5)
  phoneNumberType        String?   @db.VarChar(20)
  status                 String?   @default("active")
  provider               String    @default("telnyx")
  providerNumberId       String?
  providerOrderId        String?
  providerConnectionId   String?
  providerConnectionName String?
  purchaseDate           DateTime?
  assignedDate           DateTime?
  billingGroupId         String?
  monthlyCost            Float?
  currency               String?
  upfrontCost            Float?
  features               Json?
  userId                 String?   @db.Uuid
  organizationId         String?   @db.Uuid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userNumbers  UserNumber[]

  @@index([isoCountry])
  @@index([provider])
  @@index([providerConnectionId])
  @@index([organizationId])
}

model Contact {
  id             String    @id @default(uuid()) @db.Uuid
  name           String?
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  phoneNumber    String    @db.VarChar(20)
  email          String?   @db.VarChar(100)
  company        String?
  lastCallAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  calls         Call[]
  notes         ContactNote[]
  campaignLeads CampaignLead[]
  tags          ContactTag[]
  meetings      Meeting[]

  @@unique([userId, phoneNumber, deletedAt])
  @@index([userId])
  @@index([organizationId])
  @@index([phoneNumber])
  @@index([deletedAt])
}

model ContactNote {
  id        String    @id @default(uuid()) @db.Uuid
  contactId String    @db.Uuid
  userId    String    @db.Uuid
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([userId])
}

model CallerId {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  phoneNumber    String    @db.VarChar(20)
  provider       String    @default("telnyx")
  providerId     String?
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  calls        Call[]
  campaigns    Campaign[]    @relation("campaignCallerId")

  @@unique([userId, phoneNumber, deletedAt])
  @@index([userId])
  @@index([organizationId])
}

model Credit {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String?   @db.Uuid
  organizationId     String?   @db.Uuid
  amount             Float
  lastPurchaseAmount Float?
  lastPurchaseDate   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
  @@index([userId])
  @@index([organizationId])
}

model CreditAutoReload {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @unique @db.Uuid
  organizationId String? @unique @db.Uuid

  // Auto-reload on minimum balance
  autoReloadEnabled   Boolean @default(false)
  autoReloadThreshold Float   @default(5)
  autoReloadAmount    Float   @default(25)

  // Monthly recurring fund (Stripe subscription)
  monthlyFundEnabled       Boolean @default(false)
  monthlyFundAmount        Float?
  stripeSubscriptionId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model UserDevice {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  fcmToken String @db.Text

  lastActive DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
}

model Recording {
  id     String  @id @default(uuid()) @db.Uuid
  callId String  @db.Uuid
  url    String?
  format String? @default("mp3")
  status String? @default("started")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  status               SubscriptionStatus @default(incomplete)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  userId         String        @db.Uuid
  organizationId String?       @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([stripeSubscriptionId])
}

model Campaign {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      String  @default("draft") // draft | active | paused | completed

  // Dialer configuration
  dialerMode    DialerMode @default(progressive)
  callerIdId    String?    @db.Uuid
  maxAttempts   Int        @default(3)

  // Working hours (minutes from midnight in campaign timezone)
  timezone     String @default("America/New_York")
  workStartMin Int    @default(480) // 08:00
  workEndMin   Int    @default(1260) // 21:00
  workDays     Int[]  @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sun..6=Sat

  // Timing configuration
  wrapUpTimeSec Int @default(30)
  retryDelayMin Int @default(60)

  userId         String  @db.Uuid
  organizationId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  callerId     CallerId?      @relation("campaignCallerId", fields: [callerIdId], references: [id])
  members      CampaignMember[]
  leads        CampaignLead[]
  lists        CampaignList[]
  dispositions Disposition[]
  retryRules   RetryRule[]
  callAttempts CallAttempt[]
  agentSessions AgentSession[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model CampaignLead {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  contactId  String @db.Uuid
  listId     String? @db.Uuid

  userId String? @db.Uuid // assigned agent (optional)

  status   CampaignLeadStatus @default(pending)
  priority Int                @default(0)

  attempts   Int       @default(0)
  lastCallAt DateTime?
  nextCallAt DateTime?
  deadAt     DateTime?

  // Dialer locking
  lockedBy String?   @db.Uuid // AgentSession ID
  lockedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  list         CampaignList?  @relation(fields: [listId], references: [id], onDelete: SetNull)
  callAttempts CallAttempt[]
  callbacks    CallbackTask[]

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@index([userId])
  @@index([nextCallAt])
  @@index([status])
  @@index([campaignId, status, priority, nextCallAt])
  @@index([lockedBy])
}

model Tag {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  color          String? @db.VarChar(7)
  userId         String  @db.Uuid
  organizationId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contacts     ContactTag[]

  @@unique([userId, name, deletedAt])
  @@unique([organizationId, name, deletedAt])
  @@index([userId])
  @@index([organizationId])
}

model ContactTag {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
}

model Meeting {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  organizationId  String?       @db.Uuid
  contactId       String        @db.Uuid
  callId          String?       @db.Uuid
  title           String?
  scheduledAt     DateTime
  duration        Int           @default(30)
  location        String?
  notes           String?       @db.Text
  status          MeetingStatus @default(scheduled)
  externalEventId String?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  call         Call?         @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([contactId])
  @@index([callId])
  @@index([scheduledAt])
  @@index([status])
}

model CalendarIntegration {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String?          @db.Uuid
  provider       CalendarProvider
  accessToken    String           @db.Text
  refreshToken   String?          @db.Text
  expiresAt      DateTime?
  calendarId     String?
  email          String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([organizationId])
  @@index([userId])
}

// ── Outbound System Models ──

model CampaignList {
  id          String  @id @default(uuid()) @db.Uuid
  campaignId  String  @db.Uuid
  name        String
  description String?
  source      String? // "csv", "manual", "api"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads    CampaignLead[]

  @@index([campaignId])
}

model CallAttempt {
  id             String            @id @default(uuid()) @db.Uuid
  campaignId     String            @db.Uuid
  campaignLeadId String            @db.Uuid
  callId         String?           @db.Uuid
  agentSessionId String?           @db.Uuid
  agentUserId    String            @db.Uuid

  status        CallAttemptStatus @default(created)
  attemptNumber Int

  initiatedAt     DateTime  @default(now())
  ringStartedAt   DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  dispositionedAt DateTime?

  hangupCause String?
  durationSec Int?

  dispositionId   String? @db.Uuid
  dispositionCode String?
  dispositionNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignLead CampaignLead  @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
  call         Call?         @relation(fields: [callId], references: [id], onDelete: SetNull)
  disposition  Disposition?  @relation(fields: [dispositionId], references: [id], onDelete: SetNull)
  agentSession AgentSession? @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([campaignLeadId])
  @@index([callId])
  @@index([agentSessionId])
  @@index([campaignId, status])
  @@index([campaignId, dispositionCode])
  @@index([agentUserId, initiatedAt])
}

model Disposition {
  id         String              @id @default(uuid()) @db.Uuid
  campaignId String              @db.Uuid
  code       String
  label      String
  category   DispositionCategory
  color      String?             @db.VarChar(7)
  sortOrder  Int                 @default(0)

  triggersRetry      Boolean @default(false)
  triggersCompletion Boolean @default(false)
  triggersDnc        Boolean @default(false)
  triggersCallback   Boolean @default(false)

  isActive Boolean @default(true)
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  callAttempts CallAttempt[]

  @@unique([campaignId, code])
  @@index([campaignId])
}

model RetryRule {
  id                  String              @id @default(uuid()) @db.Uuid
  campaignId          String              @db.Uuid
  dispositionCategory DispositionCategory
  maxAttempts         Int                 @default(3)
  delayMinutes        Int                 @default(60)
  delayMultiplier     Float               @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, dispositionCategory])
  @@index([campaignId])
}

model CallbackTask {
  id             String         @id @default(uuid()) @db.Uuid
  campaignLeadId String         @db.Uuid
  agentUserId    String         @db.Uuid
  scheduledAt    DateTime
  note           String?        @db.Text
  status         CallbackStatus @default(scheduled)
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignLead CampaignLead @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)

  @@index([agentUserId])
  @@index([status, scheduledAt])
  @@index([campaignLeadId])
}

model DNCEntry {
  id             String  @id @default(uuid()) @db.Uuid
  phoneNumber    String  @db.VarChar(20)
  organizationId String  @db.Uuid
  reason         String?
  source         String? // "manual", "disposition", "import"
  addedByUserId  String? @db.Uuid

  createdAt DateTime @default(now())

  @@unique([organizationId, phoneNumber])
  @@index([phoneNumber])
  @@index([organizationId])
}

model VoicemailDropAsset {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  userId         String  @db.Uuid
  name           String
  fileUrl        String
  durationSec    Int?
  isDefault      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
}

model AgentSession {
  id             String             @id @default(uuid()) @db.Uuid
  campaignId     String             @db.Uuid
  userId         String             @db.Uuid
  organizationId String             @db.Uuid
  status         AgentSessionStatus @default(offline)
  currentLeadId  String?            @db.Uuid

  lastHeartbeat DateTime @default(now())
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  callsAttempted Int @default(0)
  callsConnected Int @default(0)
  totalTalkSec   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  callAttempts CallAttempt[]

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([userId])
  @@index([lastHeartbeat])
}

model CampaignMember {
  id         String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  userId     String @db.Uuid
  role       String @default("agent") // admin | agent

  assignedAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}
