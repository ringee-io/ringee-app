/// Idempotency ledger for credit debits caused by retriable work (provider
/// webhooks, Temporal activities, enrichment jobs, etc.). The unique key and
/// balance decrement are committed in one database transaction, so a replay
/// can never reduce the balance twice.
model CreditDebit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  organizationId String?  @db.Uuid
  amount         Float
  balanceBefore  Float?
  balanceAfter   Float?
  idempotencyKey String   @unique
  source         String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([source])
  @@index([createdAt])
}

model CreditAutoReload {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @unique @db.Uuid
  organizationId String? @unique @db.Uuid

  // Auto-reload on minimum balance
  autoReloadEnabled   Boolean @default(false)
  autoReloadThreshold Float   @default(5)
  autoReloadAmount    Float   @default(25)

  // Auto-reload runtime state. `autoReloadStatus` is both the user-facing status
  // AND the concurrency lock: the balance-drop charge only fires when a single
  // caller wins the atomic `active -> charging` transition, so simultaneous
  // `consumeCredits` calls can never trigger duplicate reloads. Re-armed to
  // `active` by the confirmed webhook.
  // Values: "disabled" | "active" | "charging" | "failed" | "requires_payment_method"
  autoReloadStatus              String    @default("disabled")
  // Explicit, separate consent to off-session charges (distinct from the
  // one-time "save card for faster top-ups" consent). Required to enable.
  autoReloadConsentAt           DateTime?
  autoReloadLastChargeAt        DateTime?
  autoReloadLastPaymentIntentId String?

  // Monthly recurring fund (Stripe subscription)
  monthlyFundEnabled   Boolean @default(false)
  monthlyFundAmount    Float?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

/// Idempotency ledger for one-time credit top-ups purchased via Stripe embedded
/// checkout. Exactly one row per completed checkout session (and per payment
/// intent), so a replayed `checkout.session.completed` webhook can never
/// double-credit a balance. Scalar-scoped on purpose — owner is stored as plain
/// ids so the ledger survives independently of the credit balance rows.
model CreditTopup {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String?  @db.Uuid
  organizationId          String?  @db.Uuid
  amount                  Float
  amountCents             Int
  // Embedded-checkout top-ups carry a session id; saved-card / auto-reload
  // charges are PaymentIntent-only, so this is nullable. Postgres lets a unique
  // index hold many NULLs, so embedded flows stay unique per session while
  // PaymentIntent-only flows rely on `stripePaymentIntentId @unique`.
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?  @unique
  // How the top-up was paid: "embedded_checkout" | "saved_payment_method" |
  // "auto_reload". Traceability only — never drives crediting logic.
  source                  String?
  status                  String   @default("completed")
  createdAt               DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
}

/// Idempotency ledger for credit GRANTS that are not Stripe purchases — offer
/// rewards, promotional credits, goodwill adjustments. The mirror image of
/// `CreditDebit`: the unique key and the balance increment commit in one
/// transaction, so a retried approval can never credit a balance twice.
/// Stripe top-ups keep their own ledger (`CreditTopup`) because they are keyed
/// on payment objects instead.
model CreditGrant {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  organizationId String?  @db.Uuid
  amount         Float
  balanceBefore  Float?
  balanceAfter   Float?
  idempotencyKey String   @unique
  /// Coarse origin, e.g. "OFFER_REWARD". Traceability only — never branching logic.
  source         String?
  /// Free-form provenance: `{ offerId, participationId, offerSlug }`.
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([source])
  @@index([createdAt])
}

