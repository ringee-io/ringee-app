// ── Custom Fields (key-value definitions + values) ──

model CustomFieldDefinition {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @db.Uuid
  userId         String?           @db.Uuid // for personal-scope definitions
  entity         CustomFieldEntity
  key            String // machine-name, e.g. "linkedin_industry"
  label          String // human label, e.g. "LinkedIn Industry"
  description    String?           @db.Text
  fieldType      CustomFieldType
  options        Json? // for select/multi_select: [{ value, label }]
  defaultValue   Json?
  required       Boolean           @default(false)
  unique         Boolean           @default(false)
  showInList     Boolean           @default(true)
  position       Int               @default(0)
  enabled        Boolean           @default(true)
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactValues ContactCustomFieldValue[]
  companyValues CompanyCustomFieldValue[]

  @@unique([organizationId, entity, key])
  @@unique([userId, entity, key])
  @@index([organizationId, entity])
  @@index([userId, entity])
}

model ContactCustomFieldValue {
  id           String @id @default(uuid()) @db.Uuid
  contactId    String @db.Uuid
  definitionId String @db.Uuid

  // Typed columns to allow filtering by the most common types without parsing JSON.
  // Exactly one is set based on the definition's fieldType; valueJson is the canonical representation.
  valueText   String?   @db.Text
  valueNumber Float?
  valueBool   Boolean?
  valueDate   DateTime?
  valueJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact    Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([contactId, definitionId])
  @@index([contactId])
  @@index([definitionId])
  @@index([definitionId, valueText])
  @@index([definitionId, valueNumber])
}

model CompanyCustomFieldValue {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @db.Uuid
  definitionId String @db.Uuid

  valueText   String?   @db.Text
  valueNumber Float?
  valueBool   Boolean?
  valueDate   DateTime?
  valueJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([companyId, definitionId])
  @@index([companyId])
  @@index([definitionId])
  @@index([definitionId, valueText])
  @@index([definitionId, valueNumber])
}

// ── Enrichment & Lead Search ──

model EnrichmentConnection {
  id             String                 @id @default(uuid()) @db.Uuid
  provider       EnrichmentProviderType
  scope          CrmConnectionScope // reuse existing scope enum
  userId         String                 @db.Uuid
  organizationId String?                @db.Uuid

  externalAccountId   String
  externalAccountName String?

  // JSON {apiKey, ...metadata} encrypted via CryptoService
  accessTokenCiphertext String @db.Text

  status        EnrichmentConnectionStatus @default(active)
  lastErrorCode String?
  lastErrorAt   DateTime?
  lastUsedAt    DateTime?

  providerMetadata Json?
  capabilities     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         EnrichmentJob[]
  leadSearches LeadSearchJob[]

  @@unique([scope, organizationId, provider])
  @@unique([scope, userId, provider, organizationId])
  @@index([provider, status])
  @@index([userId])
  @@index([organizationId])
}

model EnrichmentJob {
  id             String                 @id @default(uuid()) @db.Uuid
  connectionId   String                 @db.Uuid
  provider       EnrichmentProviderType
  contactId      String?                @db.Uuid
  userId         String                 @db.Uuid
  organizationId String?                @db.Uuid

  queryKind EnrichmentQueryKind
  queryHash String

  status        EnrichmentJobStatus @default(pending)
  attemptCount  Int                 @default(0)
  lastError     String?             @db.Text
  nextAttemptAt DateTime            @default(now())

  resultSnapshot Json?

  costCredits     Int?
  providerCredits Int?
  refundedAt      DateTime?

  dedupeKey      String  @unique
  idempotencyKey String? @unique

  triggeredBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  connection   EnrichmentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact      Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([contactId])
  @@index([userId])
  @@index([organizationId])
  @@index([connectionId])
  @@index([provider, queryHash])
}

model LeadSearchJob {
  id             String                 @id @default(uuid()) @db.Uuid
  connectionId   String                 @db.Uuid
  provider       EnrichmentProviderType
  userId         String                 @db.Uuid
  organizationId String?                @db.Uuid

  filters     Json // normalized filter payload
  filtersHash String // sha256 of normalized filters
  page        Int    @default(1)
  perPage     Int    @default(25)

  status         LeadSearchJobStatus @default(pending)
  totalResults   Int?
  resultSnapshot Json? // candidate list returned by the provider
  lastError      String?             @db.Text

  costCredits     Int?
  providerCredits Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  connection   EnrichmentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([connectionId])
  @@index([provider, filtersHash])
  @@index([status])
}

model CallScript {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  organizationId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     CallScriptSection[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model CallScriptSection {
  id       String @id @default(uuid()) @db.Uuid
  scriptId String @db.Uuid
  title    String
  body     String @db.Text
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  script CallScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([scriptId])
  @@index([scriptId, position])
}

// ── Inbox (conversational timeline) ──

enum InboxThreadStatus {
  open
  pending
  resolved
  archived
  spam
}

enum InboxEventDirection {
  inbound
  outbound
  internal
  system
}

enum InboxEventKind {
  call_started
  call_answered
  missed_call
  call_completed
  voicemail_received
  voicemail_drop_sent
  sms_received
  sms_sent
  mms_received
  mms_sent
  message_failed
  note_added
  callback_scheduled
  callback_completed
  meeting_booked
  crm_activity
  status_changed
}

enum InboxEventStatus {
  pending
  sent
  delivered
  failed
  completed
  missed
  received
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  sms
  mms
}

enum MessageStatus {
  queued
  sending
  sent
  delivered
  delivery_unconfirmed
  failed
  received
}

model InboxThread {
  id String @id @default(uuid()) @db.Uuid

  userId         String? @db.Uuid
  organizationId String? @db.Uuid
  contactId      String? @db.Uuid
  numberId       String? @db.Uuid

  participantNumber     String  @db.VarChar(30)
  participantNumberE164 String? @db.VarChar(20)

  ringeeNumber String? @db.VarChar(30)

  assignedToId String?           @db.Uuid
  status       InboxThreadStatus @default(open)

  lastEventAt    DateTime  @default(now())
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  unreadCount    Int       @default(0)

  lastPreview   String?         @db.Text
  lastEventKind InboxEventKind?

  resolvedAt DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact  Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  events   InboxEvent[]
  messages Message[]

  @@index([userId])
  @@index([organizationId])
  @@index([contactId])
  @@index([numberId])
  @@index([participantNumberE164])
  @@index([status, lastEventAt])
  @@index([assignedToId, status])
}

model InboxEvent {
  id       String @id @default(uuid()) @db.Uuid
  threadId String @db.Uuid

  direction InboxEventDirection
  kind      InboxEventKind
  status    InboxEventStatus?

  callId               String? @db.Uuid
  messageId            String? @db.Uuid
  recordingId          String? @db.Uuid
  voicemailDropAssetId String? @db.Uuid
  callbackTaskId       String? @db.Uuid
  meetingId            String? @db.Uuid

  title String?
  body  String? @db.Text

  fromNumber String? @db.VarChar(30)
  toNumber   String? @db.VarChar(30)

  audioUrl    String?  @db.Text
  mediaUrls   String[] @default([])
  durationSec Int?
  transcript  String?  @db.Text

  occurredAt DateTime @default(now())
  sequence   BigInt   @default(autoincrement())

  metadata Json?

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  thread             InboxThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  call               Call?               @relation(fields: [callId], references: [id], onDelete: SetNull)
  message            Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recording          Recording?          @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  voicemailDropAsset VoicemailDropAsset? @relation(fields: [voicemailDropAssetId], references: [id], onDelete: SetNull)
  meeting            Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([threadId, occurredAt])
  @@index([threadId, sequence])
  @@index([callId])
  @@index([messageId])
  @@index([recordingId])
  @@index([kind])
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  userId         String? @db.Uuid
  organizationId String? @db.Uuid
  contactId      String? @db.Uuid
  threadId       String? @db.Uuid
  numberId       String? @db.Uuid

  provider           String  @default("telnyx")
  providerMessageId  String? @unique
  messagingProfileId String?

  direction MessageDirection
  type      MessageType      @default(sms)
  status    MessageStatus    @default(queued)

  fromNumber String @db.VarChar(30)
  toNumber   String @db.VarChar(30)

  text      String?  @db.Text
  mediaUrls String[] @default([])

  errorCode    String?
  errorMessage String? @db.Text

  sentAt      DateTime?
  receivedAt  DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  totalCost Float?
  costMeta  Json?

  rawPayload     Json?
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  thread      InboxThread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  events      MessageEvent[]
  inboxEvents InboxEvent[]

  @@index([userId])
  @@index([organizationId])
  @@index([contactId])
  @@index([threadId])
  @@index([numberId])
  @@index([providerMessageId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([status])
  @@index([createdAt])
}

model MessageEvent {
  id              String    @id @default(uuid()) @db.Uuid
  messageId       String?   @db.Uuid
  provider        String    @default("telnyx")
  providerEventId String    @unique
  eventType       String
  payload         Json
  occurredAt      DateTime?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([eventType])
  @@index([occurredAt])
}

// ── Customizable Dashboard Layouts ──

model DashboardLayout {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String?  @db.Uuid
  name           String   @default("Default")
  scope          String // personal | organization
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  widgets DashboardWidget[]

  @@index([userId])
  @@index([organizationId])
  @@index([userId, scope])
}

model DashboardWidget {
  id          String  @id @default(uuid()) @db.Uuid
  dashboardId String  @db.Uuid
  type        String
  title       String
  x           Int
  y           Int
  w           Int
  h           Int
  config      Json?
  isVisible   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dashboard DashboardLayout @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}
