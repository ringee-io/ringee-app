// ── Custom Fields (key-value definitions + values) ──

model CustomFieldDefinition {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @db.Uuid
  userId         String?           @db.Uuid // for personal-scope definitions
  entity         CustomFieldEntity
  key            String // machine-name, e.g. "linkedin_industry"
  label          String // human label, e.g. "LinkedIn Industry"
  description    String?           @db.Text
  fieldType      CustomFieldType
  options        Json? // for select/multi_select: [{ value, label }]
  defaultValue   Json?
  required       Boolean           @default(false)
  unique         Boolean           @default(false)
  showInList     Boolean           @default(true)
  position       Int               @default(0)
  enabled        Boolean           @default(true)
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactValues ContactCustomFieldValue[]
  companyValues CompanyCustomFieldValue[]

  @@unique([organizationId, entity, key])
  @@unique([userId, entity, key])
  @@index([organizationId, entity])
  @@index([userId, entity])
}

model ContactCustomFieldValue {
  id           String @id @default(uuid()) @db.Uuid
  contactId    String @db.Uuid
  definitionId String @db.Uuid

  // Typed columns to allow filtering by the most common types without parsing JSON.
  // Exactly one is set based on the definition's fieldType; valueJson is the canonical representation.
  valueText   String?   @db.Text
  valueNumber Float?
  valueBool   Boolean?
  valueDate   DateTime?
  valueJson   Json?

