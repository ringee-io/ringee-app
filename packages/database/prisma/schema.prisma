  callerId        NumberPurchased? @relation("campaignCallerId", fields: [callerIdId], references: [id], onDelete: SetNull)
  numberPurchased NumberPurchased? @relation("campaignNumberPurchased", fields: [numberPurchasedId], references: [id], onDelete: SetNull)
  members         CampaignMember[]
  leads           CampaignLead[]
  lists           CampaignList[]
  dispositions    Disposition[]
  retryRules      RetryRule[]
  callAttempts    CallAttempt[]
  agentSessions   AgentSession[]
  callSessions    CallSession[]

