model DNCEntry {
  id             String  @id @default(uuid()) @db.Uuid
  phoneNumber    String  @db.VarChar(20)
  userId         String  @db.Uuid
  organizationId String? @db.Uuid
  reason         String?
  source         String? // "manual", "disposition", "import"
  addedByUserId  String? @db.Uuid

