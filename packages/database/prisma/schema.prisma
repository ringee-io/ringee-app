model User {
  id                    String    @id @default(uuid()) @db.Uuid
  clerkId               String?   @unique
  firstName             String?
  lastName              String?
  imageUrl              String?
  profileImageUrl       String?
  passwordEnabled       Boolean?  @default(false)
  twoFactorEnabled      Boolean?  @default(false)
  publicMetadata        Json?
  privateMetadata       Json?
  unsafeMetadata        Json?
  clientIp              String?
  userAgent             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  customerId            String?
  freeCallTrial         Boolean?  @default(false)
  // Per-user commercial/operational controls managed from the backoffice.
  // The number limit is nullable to preserve the historical "unlimited" behaviour.
  canCall               Boolean   @default(true)
  minimumCreditPurchase Float     @default(5)
  numberPurchaseLimit   Int?
  // A product-level access block. Clerk sessions are revoked separately.
  blockedAt             DateTime?
  blockedReason         String?   @db.Text
  // Primary authentication phone synchronized from Clerk (E.164).
  phoneNumber           String?   @unique @db.VarChar(32)
  phoneVerified         Boolean   @default(false)
  // Per-user onboarding requirement. Super admins can waive it when Clerk
  // cannot deliver an SMS to the user's country.
  phoneRequired         Boolean   @default(true)
  encryptionKey         String?   @db.Text

  // Onboarding state
  onboardingCompletedSteps String[]  @default([])
  onboardingDismissedAt    DateTime?

  // Per-user toggles for what gets pushed to mobile devices.
  // Shape: { callbacks: boolean, meetings: boolean, missedCalls: boolean }
  // Missing keys mean "default on" so older rows keep current behavior.
  notificationPreferences Json?

  emails                  UserEmail[]
  chatAuths               ChatAuth[]
  calls                   Call[]
  numbersOwned            NumberPurchased[]
  userNumbers             UserNumber[]
  sipDevices              SipDevice[]
  blockedCalls            BlockedCallLog[]
  Contact                 Contact[]
  ContactNote             ContactNote[]
  Credit                  Credit[]
  creditAutoReload        CreditAutoReload?
  devices                 UserDevice[]
  organizationMemberships OrganizationMembership[]
  subscriptions           Subscription[]
  campaigns               Campaign[]
  campaignMembers         CampaignMember[]
  campaignLeads           CampaignLead[]
  tags                    Tag[]
  meetings                Meeting[]
  calendarIntegrations    CalendarIntegration[]
  activitySnapshot        UserActivitySnapshot?
  crmConnections          CrmConnection[]
  companies               Company[]
  enrichmentConnections   EnrichmentConnection[]
  enrichmentJobs          EnrichmentJob[]
  leadSearchJobs          LeadSearchJob[]
  callScripts             CallScript[]
  callbacks               CallbackTask[]
  dncEntries              DNCEntry[]
  reminders               Reminder[]
  aiConversations         AiConversation[]
  aiMessages              AiMessage[]
  customIntegrations      CustomIntegration[]
  freeTrialCallRequest    FreeTrialCallRequest?
  callSessions            CallSession[]
  callRecordingSettings   CallRecordingSettings?
  callTranscriptions      CallTranscription[]
  regulatoryDocuments     RegulatoryDocument[]
  callerIdRotation        CallerIdRotationSettings?
  callerIdPoolMembers     CallerIdPoolMember[]
  aiVoiceAgents           AiVoiceAgent[]
  aiVoiceAgentCalls       AiVoiceAgentCall[]
  companyProfile          WorkspaceCompanyProfile?

  @@index([clerkId])
}

enum FreeTrialRequestStatus {
  pending
  approved
  rejected
}

/// A user's one-time request for a free trial call, reviewed manually by the
/// Ringee team (an email is sent to the team on creation). One per user
/// (`userId` unique) so it can only ever be requested once.
model FreeTrialCallRequest {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @unique @db.Uuid
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    FreeTrialRequestStatus @default(pending)
  note      String?                @db.Text
  createdAt DateTime               @default(now())
}

/// A demo request submitted from the public marketing site (/request-demo).
/// Not tied to a User — visitors are not signed in when they submit. The
/// Ringee team and the requester are both emailed on creation; the team vets
/// the profile and creates the account directly (no meeting).
model DemoRequest {
  id             String   @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String
  email          String
  phoneNumber    String
  companyWebsite String
  numberOfUsers  String
  referralSource String
  /// ISO 3166-1 alpha-2 country detected from the visitor's browser locale.
  country        String?
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  clerkId       String   @unique
  name          String
  slug          String?  @unique
  imageUrl      String?
  customerId    String? // Stripe customer ID for B2B billing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  encryptionKey String?  @db.Text

  members                OrganizationMembership[]
  chatAuths              ChatAuth[]
  calls                  Call[]
  userNumbers            UserNumber[]
  numbersPurchased       NumberPurchased[]
  sipDevices             SipDevice[]
  blockedCalls           BlockedCallLog[]
  contacts               Contact[]
  credits                Credit[]
  creditAutoReload       CreditAutoReload?
  subscriptions          Subscription[]
  campaigns              Campaign[]
  tags                   Tag[]
  meetings               Meeting[]
  calendarIntegrations   CalendarIntegration[]
  crmConnections         CrmConnection[]
  companies              Company[]
  enrichmentConnections  EnrichmentConnection[]
  enrichmentJobs         EnrichmentJob[]
  leadSearchJobs         LeadSearchJob[]
  callScripts            CallScript[]
  customFieldDefinitions CustomFieldDefinition[]
  callbacks              CallbackTask[]
  dncEntries             DNCEntry[]
  reminders              Reminder[]
  aiConversations        AiConversation[]
  customIntegrations     CustomIntegration[]
  callSessions           CallSession[]
  callRecordingSettings  CallRecordingSettings?
  callTranscriptions     CallTranscription[]
  regulatoryDocuments    RegulatoryDocument[]
  callerIdRotation       CallerIdRotationSettings?
  callerIdPoolMembers    CallerIdPoolMember[]
  aiVoiceAgents          AiVoiceAgent[]
  aiVoiceAgentCalls      AiVoiceAgentCall[]
  companyProfile         WorkspaceCompanyProfile?

  @@index([clerkId])
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  clerkUserId    String? // Clerk user ID for pending invitations
  role           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, clerkUserId])
  @@index([organizationId])
  @@index([userId])
  @@index([clerkUserId])
}

model UserEmail {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  email     String      @unique
  isPrimary Boolean     @default(false)
  status    EmailStatus @default(pending)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model ChatAuth {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  phoneNumber    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([phoneNumber])
  @@index([organizationId])
}

model DeletedUser {
  id               String    @id @default(uuid()) @db.Uuid
  originalUserId   String?   @db.Uuid
  clerkId          String?
  firstName        String?
  lastName         String?
  imageUrl         String?
  profileImageUrl  String?
  passwordEnabled  Boolean?
  twoFactorEnabled Boolean?
  publicMetadata   Json?
  privateMetadata  Json?
  unsafeMetadata   Json?
  clientIp         String?
  userAgent        String?
  phoneNumber      String?   @db.VarChar(32)
  phoneVerified    Boolean   @default(false)
  phoneRequired    Boolean   @default(true)
  deletionReason   String?
  deletedBy        String?
  deletedAt        DateTime  @default(now())
  createdAt        DateTime?
  updatedAt        DateTime?

  emails    Json?
  chatAuths Json?

  notes String?

  @@index([originalUserId])
  @@index([clerkId])
}

model Call {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @db.Uuid
  organizationId  String?    @db.Uuid
  providerCallId  String?    @unique
  connectionId    String?
  callControlId   String?    @unique
  callSessionId   String?
  callLegId       String?
  fromNumber      String
  toNumber        String
  direction       String?
  status          CallStatus @default(pending)
  durationSeconds Int?
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  totalCost       Float?
  costMeta        Json?
  contactId       String?    @db.Uuid
  contact         Contact?   @relation(fields: [contactId], references: [id])

  callerIdId String?          @db.Uuid
  callerId   NumberPurchased? @relation("callCallerId", fields: [callerIdId], references: [id])

  clientState   String?
  lastCommandId String?
  lastEventType String?
  errorMessage  String?
  directionMeta Json?

  // Telnyx's `hangup_cause` from the call.hangup webhook (e.g. "call_rejected",
  // "unallocated_number", "normal_temporary_failure"). Distinguishes a real
  // no-pickup from a carrier/permission-level rejection that also lands on
  // outcome = no_answer, since `answeredAt` never gets set in either case.
  hangupCause String?

  outcome     CallOutcome?
  outcomeNote String?      @db.Text

  // Origin channel of the call, used for history filtering/badges.
  // Values: "web" | "chrome_extension" | "mobile" | "campaign" | "session" |
  // "sip_device" | "ai_voice_agent". Null on legacy rows (treated as the
  // default web dialer).
  source String?

  // Set when this call originated from a desk phone (source = "sip_device").
  sipDeviceId String?    @db.Uuid
  sipDevice   SipDevice? @relation(fields: [sipDeviceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization       Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  transcription      CallTranscriptionSegment[]
  callTranscriptions CallTranscription[]
  recordings         Recording[]
  publicRecordings   PublicRecording[]
  meetings           Meeting[]
  callAttempts       CallAttempt[]
  crmSyncs           CrmCallSync[]
  inboxEvents        InboxEvent[]
  callbacks          CallbackTask[]
  callSessionItems   CallSessionItem[]
  aiVoiceAgentCall   AiVoiceAgentCall?

  @@index([userId])
  @@index([organizationId])
  @@index([callControlId])
  @@index([callSessionId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([sipDeviceId])
}

model CallTranscriptionSegment {
  id              String   @id @default(uuid())
  callId          String   @db.Uuid
  transcriptionId String?  @db.Uuid
  text            String
  speaker         Int?
  track           String?
  confidence      Float?
  startMs         Int?
  endMs           Int?
  isFinal         Boolean  @default(false)
  createdAt       DateTime @default(now())

  call          Call               @relation(fields: [callId], references: [id])
  transcription CallTranscription? @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([transcriptionId])
}

model TelnyxRatePerMinute {
