  @@index([userId])
  @@index([organizationId])
  @@index([campaignId])
  @@index([status])
  @@index([expiresAt])
  @@index([deletedAt])
}

model CallSessionItem {
  id            String  @id @default(uuid()) @db.Uuid
  callSessionId String  @db.Uuid
