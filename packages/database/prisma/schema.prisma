  @@index([callSessionId, createdAt])
  @@index([type])
}

// ── Call Recording & Transcription ──

// Lifecycle of a CallTranscription. Maps 1:1 to the frontend "Final Transcript"
// state machine so UI copy and backend state never drift.
enum TranscriptionStatus {
  idle // no transcript exists yet
  starting // realtime: media/Deepgram session is being set up
  transcribing // realtime: receiving live results
  processing // recording: background job is running
  completed // a final transcript exists
  failed // an attempt errored (retryable)
  unavailable // recording transcription requested but no recordingUrl
  stopped // realtime stopped before producing a final transcript
}

// Where a transcript came from. Realtime = Telnyx Media Streaming → Deepgram
// live. Recording = Deepgram pre-recorded API over the stored recordingUrl.
enum TranscriptionSource {
  realtime
  recording
}

// Per-context (organization OR user) recording & transcription preferences.
// Exactly one of organizationId / userId is set. Resolution rule lives in the
// service: if a call has an organizationId, the org row wins; otherwise the
// user row is used. There is no override/merge between the two.
model CallRecordingSettings {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @unique @db.Uuid
  organizationId String? @unique @db.Uuid

  // Record every call automatically with Telnyx.
  recordAllCalls       Boolean @default(false)
  // Transcribe active calls live (Telnyx Media Streaming → Deepgram). Does not
  // require recording.
  transcribeRealtime   Boolean @default(false)
  // Transcribe stored recordings automatically once recordingUrl is available.
  // Requires recording.
  transcribeRecordings Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

// Aggregate transcript for a call from a single source. A call can have at most
// one realtime transcript and one recording transcript (enforced by the
// @@unique below). Individual utterances live in CallTranscriptionSegment.
model CallTranscription {
  id             String  @id @default(uuid()) @db.Uuid
  callId         String  @db.Uuid
  userId         String? @db.Uuid
  organizationId String? @db.Uuid

  source TranscriptionSource
  status TranscriptionStatus @default(idle)

  // Full concatenated text of all final segments.
  text       String? @db.Text
  language   String?
  confidence Float?
  provider   String  @default("deepgram")
  model      String?

  // Source recording (only for source = recording).
  recordingId  String? @db.Uuid
  recordingUrl String? @db.Text

  errorMessage String? @db.Text
  metadata     Json?

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call         Call                       @relation(fields: [callId], references: [id], onDelete: Cascade)
  user         User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  segments     CallTranscriptionSegment[]

  @@unique([callId, source])
  @@index([callId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

// ── AI Pipeline & Pending Actions ──
// Configuration + intelligence layer. Each pipeline is independent and every
// result/counter belongs to exactly one (pipeline, context). Context is one of:
// a campaign, an organization's calls outside any campaign, or a single user's
// personal calls. Precedence is campaign > organization_outside_campaign >
// personal. See packages/services/src/services/ai-pipeline for the resolver.

enum AiPipelineType {
  follow_up_recommendations
  script_optimization
  objection_intelligence
}

enum AiPipelineContextType {
  campaign
  organization_outside_campaign
  personal
}

enum AiConfidenceLevel {
  low
  medium
  high
}

enum AiPipelineRunStatus {
  running
  completed
  failed
}

enum AiPipelineRunTrigger {
  manual
  scheduled
}

enum PendingActionType {
  send_follow_up
  create_callback
  book_meeting
  ask_for_referral
  send_pricing_or_info
  update_crm
  add_to_nurture
  mark_not_interested
  review_call
  review_script_suggestion
  approve_script_version
  review_objection_response
  add_objection_response_to_script
  review_campaign_insight
}

enum PendingActionStatus {
  pending
  completed
  dismissed
  snoozed
}

enum PendingActionPriority {
  low
  medium
  high
}

enum PendingActionSource {
  rule
  ai
  manual
}

// One activation row per (pipelineType, contextKey). `enabled` gates whether the
// pipeline counts calls and runs analysis for that context. Counters here drive
// the cadence decision and the UI; they are denormalized and made idempotent by
// CallAnalysis.countedPipelines.
model AiPipelineActivation {
  id           String                @id @default(uuid()) @db.Uuid
  pipelineType AiPipelineType
  contextType  AiPipelineContextType
  contextKey   String

  // Denormalized owners for scoping/listing (which one is set depends on
  // contextType). campaignId is the campaign; organizationId is the campaign's
  // org for campaign context, or the org for organization_outside_campaign.
  campaignId     String? @db.Uuid
  organizationId String? @db.Uuid
  userId         String? @db.Uuid

  enabled                 Boolean            @default(false)
  lastRunAt               DateTime?
  newEligibleSinceLastRun Int                @default(0)
  pendingActionCount      Int                @default(0)
  lastConfidence          AiConfidenceLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineType, contextKey])
  @@index([contextKey])
  @@index([campaignId])
  @@index([organizationId])
  @@index([userId])
}

// One run record per analysis invocation. At most one row with status=running
// per (pipelineType, contextKey) — enforced by a partial unique index created in
// the migration (Prisma cannot express a WHERE clause on @@unique).
model AiPipelineRun {
  id            String               @id @default(uuid()) @db.Uuid
  pipelineType  AiPipelineType
  contextKey    String
  status        AiPipelineRunStatus  @default(running)
  trigger       AiPipelineRunTrigger
  eligibleCount Int                  @default(0)
  confidence    AiConfidenceLevel?
  resultJson    Json?
  error         String?              @db.Text
  startedAt     DateTime             @default(now())
  finishedAt    DateTime?

  @@index([pipelineType, contextKey, status])
  @@index([contextKey])
}

// Cheap rule-based metadata per call, shared by pipeline eligibility and the
// follow-up rules. Objection Intelligence stores its separate semantic,
// at-most-once full-transcript extraction in ObjectionCallAnalysis.
model CallAnalysis {
  id     String @id @default(uuid()) @db.Uuid
  callId String @unique @db.Uuid

  contextType AiPipelineContextType?
  contextKey  String?

  outcomeClass        String?
  durationBucket      String? // too_short | short | normal | long
  hasUsableTranscript Boolean @default(false)
  objections          Json? // [{ type, evidenceExcerpt }]
  intentSignals       Json? // string[]
  notablePhrases      Json? // string[]
  language            String?
  model               String?

  // Idempotency for the call-finalized fan-out: pipelines that have already
  // counted this call toward newEligibleSinceLastRun. Guards against the
  // outcome event firing more than once for the same call.
  countedPipelines AiPipelineType[] @default([])

  analyzedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([contextKey])
}

// The user's execution center. An action belongs to exactly one (pipeline,
// context). FK columns are unenforced (idiomatic here — see CallSessionItem);
// the repository enriches contact/call/campaign for display.
model PendingAction {
  id String @id @default(uuid()) @db.Uuid

  type     PendingActionType
  status   PendingActionStatus   @default(pending)
  priority PendingActionPriority @default(medium)
  source   PendingActionSource

  title            String
  reason           String?   @db.Text
  suggestedMessage String?   @db.Text
  nextBestAction   String?   @db.Text
  dueAt            DateTime?

  snoozedUntil      DateTime?
  expiresAt         DateTime?
  countsTowardBadge Boolean   @default(true)

  // Traceability + scoping
  pipelineType   AiPipelineType?
  contextType    AiPipelineContextType
  contextKey     String
  campaignId     String?               @db.Uuid
  organizationId String?               @db.Uuid
  userId         String                @db.Uuid
  contactId      String?               @db.Uuid
  callId         String?               @db.Uuid

  // Dedupe grouped actions. Partial-unique on non-null values is created in the
  // migration so re-firing the same rule does not duplicate an action.
  groupKey String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, status])
  @@index([contextKey, status])
  @@index([status, priority, dueAt])
  @@index([campaignId])
  @@index([organizationId])
  @@index([contactId])
  @@index([callId])
}

enum ObjectionInsightStatus {
  new
  saved
  dismissed
}

enum ObjectionCallAnalysisStatus {
  processing
  completed
  failed
}

// Semantic objection extraction for one eligible call. The unique callId is
// an at-most-once claim: once a row exists, that transcript is never sent to
// the objection model again. `objections` contains dynamic, multilingual
// clusters and evidence extracted from the complete transcript.
model ObjectionCallAnalysis {
  id String @id @default(uuid()) @db.Uuid

  callId String @unique @db.Uuid

  contextType    AiPipelineContextType
  contextKey     String
  campaignId     String?               @db.Uuid
  organizationId String?               @db.Uuid
  userId         String?               @db.Uuid

  status       ObjectionCallAnalysisStatus @default(processing)
  outcomeClass String?
  language     String?
  model        String?
  objections   Json?
  error        String?                     @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([contextKey, status])
  @@index([campaignId])
  @@index([organizationId])
  @@index([userId])
}

// Pipeline-specific result store for Objection Intelligence (the template for
// "pipeline results with user state"). One row per (contextKey, objectionType):
// the latest code-measured counts + AI-analyzed reasoning, plus the user's
// state (saved/dismissed and the edited/accepted response). The trend is
// sourced from AiPipelineRun.resultJson snapshots; this table holds the current
// state and is scoped exactly like every other pipeline row (contextKey +
// denormalized owner columns).
model ObjectionInsight {
  id String @id @default(uuid()) @db.Uuid

  contextType    AiPipelineContextType
  contextKey     String
  campaignId     String?               @db.Uuid
  organizationId String?               @db.Uuid
  userId         String?               @db.Uuid

  objectionType  String // Stable dynamic semantic cluster key.
  // AI-authored label. Null remains supported for historical canonical rows.
  label          String?
  dynamic        Boolean @default(true)
  count          Int     @default(0)
  appearanceRate Float   @default(0)
  convertedRate  Float? // null until medium/high confidence (correlational)

  underlyingObjection String? @db.Text
  winningPattern      String? @db.Text
  losingPattern       String? @db.Text
  recommendedResponse String? @db.Text
  savedResponse       String? @db.Text // user-edited / accepted version
  examples            Json? // [{ excerpt, outcome }]

  status     ObjectionInsightStatus @default(new)
  confidence AiConfidenceLevel
  lastRunId  String?                @db.Uuid
  updatedAt  DateTime               @updatedAt
  createdAt  DateTime               @default(now())

  @@unique([contextKey, objectionType])
  @@index([contextKey, status])
  @@index([campaignId])
  @@index([organizationId])
}

// ── Ringee Infra (visual architecture console) ──
// A workspace-scoped overlay that renders existing entities (team members,
// numbers, SIP devices, campaigns, pools, integrations) as draggable nodes on a
// canvas and draws the relationships between them. These tables persist canvas
// state (node positions, hidden flags, draft connections) and an event trail.
// They never replace the real entities — `referenceId` points back at them.
// userId/organizationId are stored as scalar columns (no relations) so the
// overlay stays decoupled from the core models; queries scope on them directly
// via buildOwnershipFilter (organizationId when set, else userId).

enum InfrastructureResourceType {
  TEAM_MEMBER
  PHONE_NUMBER
  SIP_DEVICE
  CAMPAIGN
  NUMBER_POOL
  ROUTING_RULE
  INTEGRATION
}

enum InfrastructureConnectionType {
  ASSIGNED_TO
  USES
  ROUTES_TO
  BELONGS_TO
  OWNS
  MEMBER_OF
  TRIGGERS
}

enum InfrastructureConnectionStatus {
  ACTIVE
  DRAFT
  BROKEN
  VISUAL_ONLY
}

/// One node on the Infra canvas. Mirrors a real workspace entity by
/// (type, referenceId); rows without a referenceId are user-created drafts.
model InfrastructureResource {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  userId         String  @db.Uuid

  type        InfrastructureResourceType
  /// Id of the real entity this node represents (User, NumberPurchased,
  /// SipDevice, Campaign…). Null for draft/pending nodes.
  referenceId String?
  /// Display label. Seeded from the real entity name; editable in the inspector.
  name        String
  /// Snapshot of the entity's status at last write. The canvas recomputes the
  /// live status from the real entity on load; this is a fallback for drafts.
  status      String                     @default("ACTIVE")

  positionX Float   @default(0)
  positionY Float   @default(0)
  /// Removed from the canvas without deleting the real entity. Hidden nodes are
  /// not rendered and are not re-seeded, but can be re-added via "Link existing".
  hidden    Boolean @default(false)

  metadata Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, type, referenceId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, type])
}

/// A persisted edge the user drew that does NOT (yet) back a real relationship.
/// Edges that mirror a real DB relationship are derived on the fly at load time
/// and are not stored here.
model InfrastructureConnection {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  userId         String  @db.Uuid

  sourceResourceId String @db.Uuid
  targetResourceId String @db.Uuid

  type   InfrastructureConnectionType
  status InfrastructureConnectionStatus @default(DRAFT)

  metadata Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceResourceId, targetResourceId, type])
  @@index([organizationId])
  @@index([userId])
}

/// Append-only activity trail for the Infra console (node created/renamed/hidden,
/// connection applied/removed…). Mirrors the CallSessionEvent pattern.
model InfrastructureEvent {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  userId         String  @db.Uuid

  resourceId   String? @db.Uuid
  connectionId String? @db.Uuid

  type        String
  message     String
  actorUserId String? @db.Uuid
  payload     Json?

  createdAt DateTime @default(now())

  @@index([resourceId, createdAt])
  @@index([organizationId, createdAt])
}

// ── Offers / Promotions ──
// A generic promotion engine. An Offer is pure configuration: WHO can see it
// (audienceType + eligibilityConfig), WHERE it renders (placement), WHAT the
// user must do (actionConfig), and WHAT they get (rewardConfig). The engine
// never knows what an individual offer "means" — adding a promotion is adding
// a row, not a code path.

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

/// Where an offer renders. Only TOP_BANNER has a frontend surface today; the
/// rest exist so an offer can be authored for a placement before the surface
/// that renders it ships.
enum OfferPlacement {
  TOP_BANNER
  DASHBOARD_CARD
  MODAL
  SIDEBAR
  SETTINGS
  CHECKOUT
  CAMPAIGN_PAGE
  INBOX
}

/// Which workspace kind an offer targets. Ringee's workspace is implicit in the
/// ownership context: organizationId set = ORGANIZATION, null = PERSONAL.
enum OfferAudienceType {
  PERSONAL
  ORGANIZATION
  BOTH
}

/// Participation state machine.
///
///   ELIGIBLE ─▶ STARTED ─▶ SUBMITTED ─┬▶ PENDING_APPROVAL ─┬▶ APPROVED ─▶ REWARDED
///                                     │                    └▶ REJECTED
///                                     └▶ COMPLETED ─▶ REWARDED   (auto-approve)
enum OfferParticipationStatus {
  ELIGIBLE
  STARTED
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  REWARDED
}

/// Funnel events, the raw material for conversion metrics. Kept as its own
/// table because Ringee has no product-analytics pipeline to emit into.
enum OfferEventType {
  IMPRESSION
  CLICKED
  DISMISSED
  STARTED
  SUBMITTED
  APPROVED
  REJECTED
  REWARDED
}

model Offer {
  id           String  @id @default(uuid()) @db.Uuid
  /// Stable machine identifier used by seeds and deep links (e.g. "customer-review").
  slug         String  @unique
  /// Customer-facing name.
  name         String
  /// Ops-facing name for the backoffice list, when it differs from `name`.
  internalName String?

  /// Default copy. `displayConfig` may override per workspace kind; these are
  /// the fallback so an offer always has something to render.
  title       String
  description String? @db.Text

  status       OfferStatus       @default(DRAFT)
  placement    OfferPlacement    @default(TOP_BANNER)
  /// Higher wins when several offers compete for the same placement.
  priority     Int               @default(50)
  audienceType OfferAudienceType @default(BOTH)

  /// Rule tree evaluated against the OfferEligibilityContext. Either a bare
  /// rule group, or `{ personal, organization: { workspace, member } }`.
  eligibilityConfig Json @default("{}")
  /// What the user must do: `{ type: "EXTERNAL_URL_SUBMISSION", field, allowedDomains, unique }`.
  actionConfig      Json @default("{}")
  /// What they get: `{ type: "CREDIT", amount, currency, destination }`.
  rewardConfig      Json @default("{}")
  /// Copy templates per workspace kind, with `{{token}}` interpolation.
  displayConfig     Json @default("{}")
  /// `{ mode: "ONCE_PER_USER", dismissible, showAgainAfterHours }`.
  frequencyConfig   Json @default("{}")

  startsAt DateTime?
  endsAt   DateTime?

  /// Global cap across every participant; null = uncapped.
  maxClaims        Int?
  maxClaimsPerUser Int  @default(1)

  /// When true a submission parks in PENDING_APPROVAL until an admin acts.
  requiresApproval Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Ringee user id of the admin who authored it (null for seeded offers).
  createdBy String?

  participations OfferParticipation[]
  dismissals     OfferDismissal[]
  events         OfferEvent[]

  @@index([status, placement, priority])
  @@index([status, startsAt, endsAt])
}

/// One user's claim on one offer. `claimIndex` is the attempt number, so the
/// unique key gives a database-level guarantee of "one claim per user" for the
/// usual `maxClaimsPerUser = 1` case while leaving room for repeatable offers.
model OfferParticipation {
  id             String  @id @default(uuid()) @db.Uuid
  offerId        String  @db.Uuid
  userId         String  @db.Uuid
  /// The workspace the claim was made from — also the reward destination when
  /// `rewardConfig.destination = ORGANIZATION`.
  organizationId String? @db.Uuid
  claimIndex     Int     @default(0)

  status OfferParticipationStatus @default(STARTED)

  /// Whatever the action type asked for: `{ "url": "..." }`, survey answers, …
  /// Never an offer-specific column.
  submissionData        Json?
  /// Normalized form of the submission used to enforce cross-user uniqueness
  /// (e.g. the canonical URL). Null when the offer does not require uniqueness;
  /// Postgres allows many NULLs under a unique index.
  submissionFingerprint String?

  rewardAmount   Float?
  rewardCurrency String?

  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  completedAt DateTime?
  /// Set exactly once, in the same transaction as the credit grant.
  rewardedAt  DateTime?

  /// Ringee user id of the reviewing admin.
  approvedBy      String?
  rejectionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer  Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  events OfferEvent[]

  @@unique([offerId, userId, claimIndex])
  @@unique([offerId, submissionFingerprint])
  @@index([offerId, status])
  @@index([userId])
  @@index([organizationId])
  @@index([status, submittedAt])
}

/// "Not now". Hides an offer for `frequencyConfig.showAgainAfterHours`; never a
/// terminal state and never confused with a claim.
model OfferDismissal {
  id          String   @id @default(uuid()) @db.Uuid
  offerId     String   @db.Uuid
  userId      String   @db.Uuid
  dismissedAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([userId])
}

model OfferEvent {
  id              String          @id @default(uuid()) @db.Uuid
  offerId         String          @db.Uuid
  userId          String?         @db.Uuid
  organizationId  String?         @db.Uuid
  participationId String?         @db.Uuid
  type            OfferEventType
  placement       OfferPlacement?
  metadata        Json?
  createdAt       DateTime        @default(now())

  offer         Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  participation OfferParticipation? @relation(fields: [participationId], references: [id], onDelete: SetNull)

  @@index([offerId, type, createdAt])
  @@index([userId, createdAt])
}

// ── AI Voice Agents ──
// Pre-built voice agents (appointment booking, reminders) that Ringee runs on
// top of a provider assistant. The user configures name, model, voice,
// knowledge and post-call extraction; Ringee owns the instructions, greeting,
// tools and conversation rules per agent type.
//
// Not to be confused with AiConversation/AiAgentType above, which belong to the
// in-app chat agent.

/// The pre-built agent types shipped in V1. Each one owns its instructions,
/// tools and dynamic-variable schema in @ringee/services.
enum AiVoiceAgentType {
  appointment_booking
  reminders_notifications
}

enum AiVoiceAgentStatus {
  draft
  active
  disabled
  error
}

/// Which LLM runs the conversation. `ringee` needs no key; the others are the
/// user's own credential, held by the provider as an integration secret.
enum AiVoiceAgentModelProvider {
  ringee
  openai
  anthropic
  google
}

/// Telephony state of an agent call. Kept separate from the outcome: a call
/// can be `completed` while the outcome is `not_interested`.
enum AiVoiceAgentCallStatus {
  created
  initiating
  ringing
  in_progress
  completed
  no_answer
  busy
  voicemail
  failed
}

/// What the conversation achieved. A closed set — new members are additive.
enum AiVoiceAgentOutcome {
  appointment_booked
  confirmed
  cannot_attend
  callback_requested
  not_interested
  no_conversation
  unknown
}

enum AiVoiceAgentKnowledgeKind {
  url
  pdf
  txt
  docx
  text
}

enum AiVoiceAgentKnowledgeStatus {
  pending
  processing
  ready
  failed
}

model AiVoiceAgent {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @db.Uuid
  organizationId String? @db.Uuid

  /// The name the agent introduces itself with during the conversation.
  name   String
  type   AiVoiceAgentType
  status AiVoiceAgentStatus @default(draft)

  modelProvider AiVoiceAgentModelProvider @default(ringee)
  /// Reference to the provider-held integration secret for a BYO API key.
  /// Never the key itself — the credential never lands in Ringee's database.
  llmApiKeyRef  String?

  /// Curated voice from the Ringee catalogue (see voices.catalog.ts).
  voiceId       String?
  voiceLabel    String?
  voiceLanguage String?

  /// Company this agent speaks for. Per agent, because one workspace runs
  /// agents for several brands, products or clients. Left unset the agent
  /// falls back to `WorkspaceCompanyProfile`, so agents created before this
  /// existed keep the context they were built with.
  companyName        String?
  companyWebsite     String?
  companyDescription String? @db.Text

  /// Provider-side resources owned by this agent.
  providerAssistantId    String? @unique
  providerTexmlAppId     String?
  providerInsightGroupId String?

  /// Post-conversation processing: { summary, outcome, sentiment } toggles.
  analysisSettings Json?
  /// User-defined extraction fields, each mapped to a provider insight id.
  /// Shape: [{ key, label, type, description, insightId }]
  extractionFields Json?

  /// Appointment booking only.
  calendarIntegrationId  String? @db.Uuid
  meetingDurationMinutes Int     @default(30)
  timezone               String?
  meetingTitle           String?

  /// Hashed shared secret proving a provider tool callback really came from
  /// this agent's assistant. Hashed with the custom-integration key util.
  toolSecretHash String?

  lastError String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendarIntegration CalendarIntegration?          @relation(fields: [calendarIntegrationId], references: [id], onDelete: SetNull)
  knowledgeSources    AiVoiceAgentKnowledgeSource[]
  calls               AiVoiceAgentCall[]

  @@index([userId])
  @@index([organizationId])
  @@index([userId, type])
  @@index([deletedAt])
}

/// One knowledge source attached to an agent. The embedded copy lives with the
/// provider; this row is Ringee's record of what the user added.
model AiVoiceAgentKnowledgeSource {
  id      String                    @id @default(uuid()) @db.Uuid
  agentId String                    @db.Uuid
  kind    AiVoiceAgentKnowledgeKind
  label   String

  /// For `url` sources.
  sourceUrl  String?
  /// For uploaded documents: the key in Ringee's own storage.
  storageKey String?
  /// For `text` sources: the raw content the user typed.
  content    String? @db.Text

  providerBucket   String?
  providerFileName String?
  embeddingTaskId  String?
  status           AiVoiceAgentKnowledgeStatus @default(pending)
  lastError        String?                     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent AiVoiceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
}

/// The agent-side half of a call. The telephony half is a normal `Call` row
/// (source = "ai_voice_agent"), so recordings, transcripts, cost settlement,
/// DNC and history all keep working unchanged.
model AiVoiceAgentCall {
  id             String  @id @default(uuid()) @db.Uuid
  agentId        String  @db.Uuid
  userId         String  @db.Uuid
  organizationId String? @db.Uuid

  /// Null until the provider accepts the call and the webhook binds the row.
  callId String? @unique @db.Uuid

  toNumber   String
  fromNumber String
  contactId  String? @db.Uuid

  status  AiVoiceAgentCallStatus @default(created)
  outcome AiVoiceAgentOutcome?

  /// Hashed single-call token the provider presents on the status callback.
  /// The callback route is public, so this is its proof of authorization.
  callbackTokenHash String?

  /// Provider conversation this call produced; the join key for insights and
  /// for the usage records the cost reconciler reads.
  providerConversationId String? @unique
  providerCallControlId  String?

  /// Dynamic variables the caller supplied, validated against the agent type's
  /// schema before the call was placed.
  variables Json?
  /// Caller-supplied passthrough (e.g. `external_id`), echoed back on results.
  metadata  Json?

  summary       String? @db.Text
  sentiment     String?
  extractedData Json?
  /// Set by the booking tool when the agent really created the appointment.
  meetingId     String? @db.Uuid

  /// Provider-reported AI cost in USD, and what Ringee charged for it.
  aiCostUsd        Float?
  aiChargedCredits Float?
  /// Idempotency marker for the AI-usage debit (BILL-003/BILL-004).
  costSettledAt    DateTime?

  lastError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent        AiVoiceAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  call         Call?         @relation(fields: [callId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  meeting      Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([userId])
  @@index([organizationId])
  @@index([agentId, createdAt])
  @@index([status])
}

/// Workspace-wide company context: the fallback an AI voice agent uses when it
/// carries no company context of its own. Agents set theirs on the agent row —
/// this is what agents created before that keep speaking with. One row per
/// workspace: a personal workspace sets userId, an organization sets
/// organizationId.
model WorkspaceCompanyProfile {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @unique @db.Uuid
  organizationId String? @unique @db.Uuid

  companyName        String?
  companyWebsite     String?
  companyDescription String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}
