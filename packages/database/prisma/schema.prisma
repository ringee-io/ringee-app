model UserNumber {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String?  @db.Uuid
  numberId       String   @db.Uuid
  isPrimary      Boolean  @default(false)
  canCall        Boolean  @default(true)
  canReceive     Boolean  @default(true)
  canRecord      Boolean  @default(false)
  canSendSms     Boolean  @default(false)
  canReceiveSms  Boolean  @default(false)
  canSendMms     Boolean  @default(false)
  canReceiveMms  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  enabled        Boolean  @default(false)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  numberPurchased NumberPurchased @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([userId, numberId, enabled])
  @@index([numberId])
  @@index([userId])
  @@index([organizationId])
}

/// Where inbound calls to a number ring. See NumberPurchased.inboundMode.
enum NumberInboundMode {
  ringee_default
  desk_phone_only
}

/// Ringee surfaces allowed to present a number as an outbound caller ID.
enum OutboundSource {
  web
  chrome_extension
  mobile
  sip_device
  ai_voice_agent
}

/// Lifecycle of a SIP desk phone as Ringee understands it.
/// - pending:    created in Telnyx, no SIP REGISTER seen yet.
/// - registered: the phone is currently registered to Telnyx.
/// - offline:    was registered, but Telnyx no longer reports it online.
/// - disabled:   Ringee turned the device off — no inbound or outbound.
/// - deleted:    soft-deleted; the Telnyx connection has been torn down.
enum SipDeviceStatus {
  pending
  registered
  offline
  disabled
  deleted
}

/// A physical SIP phone (Yealink, Grandstream, Cisco…) or softphone connected
/// to Ringee through a dedicated Telnyx Credential Connection. One device ==
/// one Telnyx SIP Connection. The connection has Park Outbound Calls enabled so
/// Ringee can validate credit / DNC / caller ID before bridging outbound calls.
model SipDevice {
  id        String @id @default(uuid()) @db.Uuid
  /// Short, user-visible reference, e.g. "dev_8k4m2p9x". Never the raw UUID.
  publicRef String @unique

  organizationId String? @db.Uuid
  userId         String  @db.Uuid

  label      String // "Office Yealink"
  deviceType String? // yealink | grandstream | cisco | zoiper | other
  provider   String  @default("telnyx")

  // ── Telnyx wiring ────────────────────────────────────────────────────────
  telnyxConnectionId   String  @unique
  telnyxConnectionName String
  /// Telnyx telephony_credential id backing the SIP username/password.
  telnyxCredentialId   String?
  sipUsername          String  @unique // "rg_dev_8k4m2p9x"
  /// AES-GCM encrypted SIP password (CryptoService). Never returned in clear
  /// except at creation / explicit regeneration.
  sipPasswordEncrypted String  @db.Text

  outboundVoiceProfileId String?
  parkOutboundEnabled    Boolean @default(true)

  // ── Number / routing ─────────────────────────────────────────────────────
  /// The number this device uses (inbound target when allowInbound, and the
  /// device's default outbound caller ID).
  assignedPhoneNumberId String? @db.Uuid
  /// E.164 snapshot of the caller ID the device presents on outbound calls.
  callerId              String?

  allowInbound  Boolean           @default(true)
  allowOutbound Boolean           @default(true)
  inboundMode   NumberInboundMode @default(desk_phone_only)

  status SipDeviceStatus @default(pending)

  // ── Operational limits (security) ─────────────────────────────────────────
  maxConcurrentCalls Int?
  dailySpendLimit    Float?

  // ── Last-seen registration telemetry (best-effort from Telnyx) ─────────────
  lastRegisteredAt DateTime?
  lastIpAddress    String?
  lastUserAgent    String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedNumber NumberPurchased?  @relation("SipDeviceAssignedNumber", fields: [assignedPhoneNumberId], references: [id], onDelete: SetNull)
  inboundNumbers NumberPurchased[] @relation("NumberInboundSipDevice")
  calls          Call[]
  blockedCalls   BlockedCallLog[]

  @@index([organizationId])
  @@index([userId])
  @@index([telnyxConnectionId])
  @@index([assignedPhoneNumberId])
  @@index([status])
}

/// Append-only audit of outbound attempts Ringee refused to connect (DNC,
/// no credit, caller ID not permitted, device disabled…). Primarily fed by the
/// desk-phone webhook, but generic enough for any source.
model BlockedCallLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @db.Uuid
  userId         String? @db.Uuid
  sipDeviceId    String? @db.Uuid

  source     String  @default("sip_device")
  fromNumber String?
  toNumber   String?
  callerId   String?
  /// Machine reason, e.g. DNC | INSUFFICIENT_CREDIT | CALLER_ID_NOT_ALLOWED |
  /// DEVICE_DISABLED | DEVICE_NOT_FOUND | OUTBOUND_DISABLED.
  reason     String
  detail     String? @db.Text

  /// Telnyx ids for traceability + idempotency.
  providerEventId    String?
  providerCallId     String?
  telnyxConnectionId String?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sipDevice    SipDevice?    @relation(fields: [sipDeviceId], references: [id], onDelete: SetNull)

  @@unique([providerEventId])
  @@index([organizationId])
  @@index([sipDeviceId])
  @@index([reason])
  @@index([createdAt])
}

model NumberPurchased {
  id                     String    @id @default(uuid()) @db.Uuid
  phoneNumber            String    @unique
  isoCountry             String    @db.VarChar(5)
  phoneNumberType        String?   @db.VarChar(20)
  status                 String?   @default("active")
  provider               String    @default("telnyx")
  providerNumberId       String?
  providerOrderId        String?
  providerConnectionId   String?
  providerConnectionName String?
  purchaseDate           DateTime?
  assignedDate           DateTime?
  billingGroupId         String?
  monthlyCost            Float?
  currency               String?
  upfrontCost            Float?
  features               Json?
  userId                 String?   @db.Uuid
  organizationId         String?   @db.Uuid

  // Distinguishes a real purchased Telnyx DID from an external number the user
  // owns elsewhere and verified via Telnyx Verified Numbers to use as a caller ID.
  kind NumberKind @default(purchased)

  // Caller-ID verification (only meaningful when kind = verified_caller_id).
  verified                Boolean   @default(false)
  active                  Boolean   @default(true)
  verificationStatus      String? // pending | verified | failed | expired
  verificationMethod      String? // sms | call
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?
  verificationFee         Float? // last fee charged for a verification attempt
  deletedAt               DateTime?

  // Messaging capabilities (snapshot derived from provider features)
  providerMessagingProfileId String?
  messagingEnabled           Boolean @default(false)
  smsEnabled                 Boolean @default(false)
  mmsEnabled                 Boolean @default(false)
  voiceEnabled               Boolean @default(false)
  faxEnabled                 Boolean @default(false)
  hdVoiceEnabled             Boolean @default(false)
  internationalSmsEnabled    Boolean @default(false)
  emergencyEnabled           Boolean @default(false)
  messagingStatus            String?
  messagingError             String? @db.Text

  // ── Inbound routing (Desk Phones) ──────────────────────────────────────
  // Where inbound calls to this number currently ring.
  // - ringee_default: Ringee Web / Chrome Extension / Mobile (the legacy path).
  // - desk_phone_only: a single SIP desk phone; the number does NOT ring in
  //   any Ringee app. The number stays usable as an outbound caller ID.
  inboundMode        NumberInboundMode @default(ringee_default)
  inboundSipDeviceId String?           @db.Uuid

  // Which Ringee surfaces may present this number as an outbound caller ID.
  // Empty list is treated as "no restriction" by callers.
  allowedOutboundSources OutboundSource[] @default([web, chrome_extension, mobile, sip_device])

  // Optional per-user allow-list for using this number as a caller ID.
  // Empty means every member of the owning workspace may use it.
  allowedOutboundUserIds String[] @default([]) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization         Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userNumbers          UserNumber[]
  inboundSipDevice     SipDevice?               @relation("NumberInboundSipDevice", fields: [inboundSipDeviceId], references: [id], onDelete: SetNull)
  assignedToSipDevices SipDevice[]              @relation("SipDeviceAssignedNumber")
  campaigns            Campaign[]               @relation("campaignNumberPurchased")
  campaignsAsCallerId  Campaign[]               @relation("campaignCallerId")
  callsAsCallerId      Call[]                   @relation("callCallerId")
  requirementValues    NumberRequirementValue[]
  rotationMember       CallerIdPoolMember?
  rotationUsage        CallerIdDailyUsage[]

  @@index([isoCountry])
  @@index([provider])
  @@index([userId])
  @@index([providerConnectionId])
  @@index([organizationId])
  @@index([providerMessagingProfileId])
  @@index([kind])
  @@index([inboundSipDeviceId])
}

enum NumberKind {
  purchased
  verified_caller_id
}

/// Lifecycle state of a number inside the caller-ID rotation pool.
/// - active:   eligible for selection.
/// - cooling:  temporarily out after a low health score; re-enters after coolingUntil.
/// - flagged:  marked as spam by a carrier; out until manual review (never auto-cleared).
/// - disabled: the user removed it from rotation manually.
enum CallerIdRotationStatus {
  active
  cooling
  flagged
  disabled
}

/// Per-workspace caller-ID rotation settings — the GLOBAL toggle. Scoped to the
/// active workspace (organization if active, otherwise the user), mirroring the
/// CallRecordingSettings singleton pattern.
model CallerIdRotationSettings {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @unique @db.Uuid
  organizationId String? @unique @db.Uuid

  /// When true, every dialer (manual, campaign, session) rotates the caller ID.
  enabled         Boolean @default(false)
  /// "local_presence" (prefer destination area code) | "balanced" (country only).
  strategy        String  @default("local_presence")
  /// Default per-number daily cap; a pool member may override it.
  defaultDailyCap Int     @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

/// Rotation state for one owned number (purchased DID or verified caller ID).
/// Kept separate from NumberPurchased so reporting joins stay clean and the base
/// number row is untouched.
model CallerIdPoolMember {
  id             String  @id @default(uuid()) @db.Uuid
  numberId       String  @unique @db.Uuid
  userId         String? @db.Uuid
  organizationId String? @db.Uuid

  /// Whether the user keeps this number in the rotation pool.
  participating  Boolean                @default(true)
  rotationStatus CallerIdRotationStatus @default(active)
  /// Per-number daily cap override; null inherits settings.defaultDailyCap.
  dailyCap       Int?
  /// 0-100, derived from answer rate and short-call ratio over a moving window.
  healthScore    Int                    @default(100)
  lastUsedAt     DateTime?
  /// When a cooling number becomes eligible to re-enter (if score recovered).
  coolingUntil   DateTime?
  flaggedAt      DateTime?
  /// Cached destination matching prefix (national area/significant code).
  areaCode       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  number       NumberPurchased @relation(fields: [numberId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([rotationStatus])
}

/// Per-number, per-day usage counter. Avoids racy midnight resets (we read the
/// row for "today") and powers calls/day reporting + health scoring.
model CallerIdDailyUsage {
  id         String   @id @default(uuid()) @db.Uuid
  numberId   String   @db.Uuid
  day        DateTime @db.Date
  count      Int      @default(0)
  answered   Int      @default(0)
  shortCalls Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  number NumberPurchased @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([numberId, day])
  @@index([day])
}

/// Reusable regulatory document stored in Ringee's own bucket, scoped to a
/// workspace (organization if active, otherwise the user). The file lives at
/// `storageKey`; that same key is used as the filename when the document is
/// later uploaded to Telnyx, and `telnyxDocumentId` caches that upload so a
/// document reused across number requests is only sent to the carrier once.
model RegulatoryDocument {
  id               String  @id @default(uuid()) @db.Uuid
  filename         String
  contentType      String
  size             Int
  storageKey       String
  url              String?
  telnyxDocumentId String?
  userId           String? @db.Uuid
  organizationId   String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirementValues NumberRequirementValue[]

  @@index([userId])
  @@index([organizationId])
}

/// Persisted form value for one regulatory requirement of a purchased number.
/// Stored as the user fills the verification form (autosave) so a reload
/// restores everything; `submittedAt` is set once the value is sent to Telnyx.
/// Exactly one of textValue / addressJson / regulatoryDocumentId is set,
/// matching `fieldType`.
model NumberRequirementValue {
  id                   String    @id @default(uuid()) @db.Uuid
  numberPurchasedId    String    @db.Uuid
  requirementId        String
  fieldType            String
  textValue            String?   @db.Text
  addressJson          Json?
  regulatoryDocumentId String?   @db.Uuid
  submittedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numberPurchased    NumberPurchased     @relation(fields: [numberPurchasedId], references: [id], onDelete: Cascade)
  regulatoryDocument RegulatoryDocument? @relation(fields: [regulatoryDocumentId], references: [id], onDelete: SetNull)

  @@unique([numberPurchasedId, requirementId])
  @@index([numberPurchasedId])
}

