  @@index([organizationId])
  @@index([status])
  @@index([numberPurchasedId])
}

model CampaignLead {
  id         String  @id @default(uuid()) @db.Uuid
  campaignId String  @db.Uuid
  contactId  String  @db.Uuid
  listId     String? @db.Uuid

  userId String? @db.Uuid // assigned agent (optional)

  status   CampaignLeadStatus @default(pending)
  priority Int                @default(0)

  attempts   Int       @default(0)
  lastCallAt DateTime?
  nextCallAt DateTime?
  deadAt     DateTime?

  // Dialer locking
  lockedBy String?   @db.Uuid // AgentSession ID
  lockedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  list         CampaignList?  @relation(fields: [listId], references: [id], onDelete: SetNull)
  callAttempts CallAttempt[]
  callbacks    CallbackTask[]

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@index([userId])
  @@index([nextCallAt])
  @@index([status])
  @@index([campaignId, status, priority, nextCallAt])
  @@index([lockedBy])
}

