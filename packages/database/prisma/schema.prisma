  description String?
  status      String  @default("draft") // draft | active | paused | completed

  // Dialer configuration
  dialerMode        DialerMode @default(progressive)
  callerIdId        String?    @db.Uuid
  // Purchased number used as the outbound caller ID for this campaign's calls
  numberPurchasedId String?    @db.Uuid
  // Subset of owned numbers this campaign rotates among when caller-ID rotation
