generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://ringee-user:ringee-password@localhost:5432/ringee-db-local?schema=public"
}

enum EmailStatus {
  pending
  verified
  unverified
}

enum CallStatus {
  pending
  ringing
  answered
  recording
  completed
  failed
}

enum CallOutcome {
  meeting_booked
  sale
  interested
  follow_up
  callback_scheduled
  not_interested
  no_answer
  voicemail
  wrong_number
  gatekeeper
}

enum CalendarProvider {
  google
  microsoft
}

enum MeetingStatus {
  scheduled
  completed
  cancelled
  rescheduled
}

enum ReminderSubjectType {
  callback
  meeting
  followup
}

enum ReminderStatus {
  pending
  sent
  failed
  cancelled
  snoozed
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  incomplete
}

// ── Outbound System Enums ──

enum DialerMode {
  progressive
  preview
}

enum CampaignLeadStatus {
  pending
  queued
  locked
  dialing
  in_call
  wrap_up
  dispositioned
  scheduled
  completed
  exhausted
  dnc
}

enum AgentSessionStatus {
  ready
  reserved
  dialing
  in_call
  wrap_up
  paused
  offline
}

enum CallAttemptStatus {
  created
  dialing
  ringing
  answered
  in_call
  ended
  dispositioned
}

enum DispositionCategory {
  positive
  neutral
  negative
  no_contact
}

enum CallbackStatus {
  scheduled
  due
  in_progress
  completed
  missed
  cancelled
}

// ── CRM Integration Enums ──

enum CrmProviderType {
  attio
  hubspot
  salesforce
  odoo_14_18
  odoo_19_plus
}

enum CrmConnectionScope {
  personal
  organization
}

enum CrmConnectionStatus {
  active
  expired
  revoked
  error
  disconnected
}

enum CrmRecordType {
  person
  company
  list
}

enum CrmSyncStatus {
  pending
  in_progress
  done
  failed
  skipped
  needs_resolution
}

enum CrmOutboxStatus {
  pending
  in_progress
  sent
  failed
}

// ── Data Enrichment & Lead Search Enums ──

enum EnrichmentProviderType {
  prospeo
  apollo
}

enum EnrichmentConnectionStatus {
  active
  error
  disconnected
}

enum EnrichmentJobStatus {
  pending
  in_progress
  done
  failed
  skipped
  not_found
}

enum EnrichmentQueryKind {
  email
  domain
  linkedin
  name_company
  phone
}

enum LeadSearchJobStatus {
  pending
  in_progress
  done
  failed
}

// ── Custom Fields Enums ──

enum CustomFieldEntity {
  contact
  company
}

enum CustomFieldType {
  text
  number
  boolean
  date
  url
  email
  phone
  select
  multi_select
  json
}

// ── Social Link Platforms ──

enum SocialPlatform {
  linkedin
  twitter
  github
  facebook
  instagram
  youtube
  tiktok
  pinterest
  reddit
  medium
  dribbble
  behance
  stackoverflow
  angellist
  crunchbase
  producthunt
  website
  blog
  calendly
  skype
  telegram
  whatsapp
  signal
  discord
  slack
  other
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  clerkId          String?  @unique
  firstName        String?
  lastName         String?
  imageUrl         String?
  profileImageUrl  String?
  passwordEnabled  Boolean? @default(false)
  twoFactorEnabled Boolean? @default(false)
  publicMetadata   Json?
  privateMetadata  Json?
  unsafeMetadata   Json?
  clientIp         String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customerId       String?
  freeCallTrial    Boolean? @default(true)
  encryptionKey    String?  @db.Text

  // Onboarding state
  onboardingCompletedSteps String[]  @default([])
  onboardingDismissedAt    DateTime?

  emails                  UserEmail[]
  chatAuths               ChatAuth[]
  calls                   Call[]
  numbersOwned            NumberPurchased[]
  userNumbers             UserNumber[]
  Contact                 Contact[]
  ContactNote             ContactNote[]
  CallerId                CallerId[]
  Credit                  Credit[]
  creditAutoReload        CreditAutoReload?
  devices                 UserDevice[]
  organizationMemberships OrganizationMembership[]
  subscriptions           Subscription[]
  campaigns               Campaign[]
  campaignMembers         CampaignMember[]
  campaignLeads           CampaignLead[]
  tags                    Tag[]
  meetings                Meeting[]
  calendarIntegrations    CalendarIntegration[]
  activitySnapshot        UserActivitySnapshot?
  crmConnections          CrmConnection[]
  companies               Company[]
  enrichmentConnections   EnrichmentConnection[]
  enrichmentJobs          EnrichmentJob[]
  leadSearchJobs          LeadSearchJob[]
  callScripts             CallScript[]
  callbacks               CallbackTask[]
  dncEntries              DNCEntry[]
  reminders               Reminder[]

  @@index([clerkId])
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  clerkId       String   @unique
  name          String
  slug          String?  @unique
  imageUrl      String?
  customerId    String? // Stripe customer ID for B2B billing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  encryptionKey String?  @db.Text

  members                OrganizationMembership[]
  chatAuths              ChatAuth[]
  calls                  Call[]
  userNumbers            UserNumber[]
  numbersPurchased       NumberPurchased[]
  contacts               Contact[]
  callerIds              CallerId[]
  credits                Credit[]
  creditAutoReload       CreditAutoReload?
  subscriptions          Subscription[]
  campaigns              Campaign[]
  tags                   Tag[]
  meetings               Meeting[]
  calendarIntegrations   CalendarIntegration[]
  crmConnections         CrmConnection[]
  companies              Company[]
  enrichmentConnections  EnrichmentConnection[]
  enrichmentJobs         EnrichmentJob[]
  leadSearchJobs         LeadSearchJob[]
  callScripts            CallScript[]
  customFieldDefinitions CustomFieldDefinition[]
  callbacks              CallbackTask[]
  dncEntries             DNCEntry[]
  reminders              Reminder[]

  @@index([clerkId])
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  clerkUserId    String? // Clerk user ID for pending invitations
  role           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, clerkUserId])
  @@index([organizationId])
  @@index([userId])
  @@index([clerkUserId])
}

model UserEmail {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  email     String      @unique
  isPrimary Boolean     @default(false)
  status    EmailStatus @default(pending)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model ChatAuth {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  phoneNumber    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([phoneNumber])
  @@index([organizationId])
}

model DeletedUser {
  id               String    @id @default(uuid()) @db.Uuid
  originalUserId   String?   @db.Uuid
  clerkId          String?
  firstName        String?
  lastName         String?
  imageUrl         String?
  profileImageUrl  String?
  passwordEnabled  Boolean?
  twoFactorEnabled Boolean?
  publicMetadata   Json?
  privateMetadata  Json?
  unsafeMetadata   Json?
  clientIp         String?
  userAgent        String?
  deletionReason   String?
  deletedBy        String?
  deletedAt        DateTime  @default(now())
  createdAt        DateTime?
  updatedAt        DateTime?

  emails    Json?
  chatAuths Json?

  notes String?

  @@index([originalUserId])
  @@index([clerkId])
}

model Call {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @db.Uuid
  organizationId  String?    @db.Uuid
  providerCallId  String?    @unique
  connectionId    String?
  callControlId   String?    @unique
  callSessionId   String?
  callLegId       String?
  fromNumber      String
  toNumber        String
  direction       String?
  status          CallStatus @default(pending)
  durationSeconds Int?
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  totalCost       Float?
  costMeta        Json?
  contactId       String?    @db.Uuid
  contact         Contact?   @relation(fields: [contactId], references: [id])

  callerIdId String?   @db.Uuid
  callerId   CallerId? @relation(fields: [callerIdId], references: [id])

  clientState   String?
  lastCommandId String?
  lastEventType String?
  errorMessage  String?
  directionMeta Json?

  outcome     CallOutcome?
  outcomeNote String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization     Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  transcription    CallTranscriptionSegment[]
  recordings       Recording[]
  publicRecordings PublicRecording[]
  meetings         Meeting[]
  callAttempts     CallAttempt[]
  crmSyncs         CrmCallSync[]
  inboxEvents      InboxEvent[]
  callbacks        CallbackTask[]

  @@index([userId])
  @@index([organizationId])
  @@index([callControlId])
  @@index([callSessionId])
  @@index([fromNumber])
  @@index([toNumber])
}

model CallTranscriptionSegment {
  id        String   @id @default(uuid())
  callId    String   @db.Uuid
  text      String
  speaker   Int?
  track     String?
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id])
}

model TelnyxRatePerMinute {
  id                  String   @id @default(uuid()) @db.Uuid
  iso                 String   @db.VarChar(10)
  country             String
  originationPrefixes String?  @db.Text
  destinationPrefixes String?  @db.Text
  description         String?  @db.Text
  interval1           Int?     @map("interval_1")
  intervalN           Int?     @map("interval_n")
  rate                Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([iso])
  @@index([country])
}

model UserNumber {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String?  @db.Uuid
  numberId       String   @db.Uuid
  isPrimary      Boolean  @default(false)
  canCall        Boolean  @default(true)
  canReceive     Boolean  @default(true)
  canRecord      Boolean  @default(false)
  canSendSms     Boolean  @default(false)
  canReceiveSms  Boolean  @default(false)
  canSendMms     Boolean  @default(false)
  canReceiveMms  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  enabled        Boolean  @default(false)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  numberPurchased NumberPurchased @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([userId, numberId, enabled])
  @@index([numberId])
  @@index([userId])
  @@index([organizationId])
}

model NumberPurchased {
  id                     String    @id @default(uuid()) @db.Uuid
  phoneNumber            String    @unique
  isoCountry             String    @db.VarChar(5)
  phoneNumberType        String?   @db.VarChar(20)
  status                 String?   @default("active")
  provider               String    @default("telnyx")
  providerNumberId       String?
  providerOrderId        String?
  providerConnectionId   String?
  providerConnectionName String?
  purchaseDate           DateTime?
  assignedDate           DateTime?
  billingGroupId         String?
  monthlyCost            Float?
  currency               String?
  upfrontCost            Float?
  features               Json?
  userId                 String?   @db.Uuid
  organizationId         String?   @db.Uuid

  // Messaging capabilities (snapshot derived from provider features)
  providerMessagingProfileId String?
  messagingEnabled           Boolean @default(false)
  smsEnabled                 Boolean @default(false)
  mmsEnabled                 Boolean @default(false)
  voiceEnabled               Boolean @default(false)
  faxEnabled                 Boolean @default(false)
  hdVoiceEnabled             Boolean @default(false)
  internationalSmsEnabled    Boolean @default(false)
  emergencyEnabled           Boolean @default(false)
  messagingStatus            String?
  messagingError             String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userNumbers  UserNumber[]

  @@index([isoCountry])
  @@index([provider])
  @@index([providerConnectionId])
  @@index([organizationId])
  @@index([providerMessagingProfileId])
}

model Contact {
  id             String    @id @default(uuid()) @db.Uuid
  name           String?
  firstName      String?
  lastName       String?
  middleName     String?
  fullName       String?
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  phoneNumber    String    @db.VarChar(20)
  email          String?   @db.VarChar(100)
  company        String?
  jobTitle       String?
  source         String?
  ownerId        String?   @db.Uuid
  lastCallAt     DateTime?
  crmMetadata    Json?
  customFields   Json?

  // ── Extended professional/social fields ──
  headline        String? @db.Text
  summary         String? @db.Text
  seniority       String?
  department      String?
  yearsExperience Int?

  // Social profiles (typed for fast queries)
  linkedinUrl  String? @db.VarChar(255)
  twitterUrl   String? @db.VarChar(255)
  githubUrl    String? @db.VarChar(255)
  facebookUrl  String? @db.VarChar(255)
  instagramUrl String? @db.VarChar(255)
  youtubeUrl   String? @db.VarChar(255)
  tiktokUrl    String? @db.VarChar(255)
  websiteUrl   String? @db.VarChar(255)
  blogUrl      String? @db.VarChar(255)
  calendlyUrl  String? @db.VarChar(255)

  // Location
  locationCity        String?
  locationRegion      String?
  locationCountry     String?
  locationCountryCode String? @db.VarChar(3)
  locationPostalCode  String?
  timezone            String?

  // Languages, skills, education stored as arrays/JSON for flexibility
  languages   String[]
  skills      String[]
  interests   String[]
  education   Json? // [{ school, degree, field, startYear, endYear }]
  workHistory Json? // [{ company, title, startDate, endDate, current }]

  // Demographic & marketing data
  birthday      DateTime?
  gender        String?
  maritalStatus String?

  // Engagement / scoring
  score          Int? // engagement / quality score
  status         String? // lead status: new | contacted | qualified | customer | lost | ...
  lifecycleStage String? // subscriber | lead | mql | sql | opportunity | customer | evangelist

  // Verification
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Enrichment metadata
  enrichmentMetadata Json? // last enrichment summary { provider, at, confidence, source }
  lastEnrichedAt     DateTime?

  // Marketing preferences
  unsubscribed Boolean @default(false)
  doNotCall    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  calls             Call[]
  notes             ContactNote[]
  campaignLeads     CampaignLead[]
  tags              ContactTag[]
  meetings          Meeting[]
  crmLinks          CrmContactLink[]
  phones            ContactPhone[]
  emails            ContactEmail[]
  affiliations      ContactAffiliation[]
  socialLinks       ContactSocialLink[]
  customFieldValues ContactCustomFieldValue[]
  enrichmentJobs    EnrichmentJob[]
  inboxThreads      InboxThread[]
  messages          Message[]
  callbacks         CallbackTask[]

  @@unique([userId, phoneNumber, deletedAt])
  @@index([userId])
  @@index([organizationId])
  @@index([phoneNumber])
  @@index([deletedAt])
  @@index([ownerId])
  @@index([source])
  @@index([linkedinUrl])
  @@index([locationCountryCode])
  @@index([status])
  @@index([lifecycleStage])
  @@index([lastEnrichedAt])
}

model ContactNote {
  id        String    @id @default(uuid()) @db.Uuid
  contactId String    @db.Uuid
  userId    String    @db.Uuid
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([userId])
}

model ContactPhone {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @db.Uuid
  phone     String   @db.VarChar(30)
  phoneE164 String?  @db.VarChar(20)
  type      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, phone])
  @@index([contactId])
  @@index([phoneE164])
}

model ContactEmail {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @db.Uuid
  email     String   @db.VarChar(255)
  type      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, email])
  @@index([contactId])
  @@index([email])
}

model Company {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  legalName        String?
  domain           String?
  secondaryDomains String[]
  industry         String?
  subIndustry      String?
  size             String? // human-readable like "11-50", kept for compatibility
  phone            String?  @db.VarChar(30)
  website          String?
  userId           String   @db.Uuid
  organizationId   String?  @db.Uuid
  source           String?
  crmMetadata      Json?
  customFields     Json?

  // ── Extended company fields ──
  description        String? @db.Text
  shortDescription   String? @db.VarChar(500)
  foundedYear        Int?
  employeeCount      Int?
  employeeCountRange String? // "1-10", "11-50", "51-200", ...
  annualRevenue      BigInt? // USD cents
  revenueRange       String? // "$1M-$10M"
  fundingTotal       BigInt? // USD cents
  fundingStage       String? // seed | series_a | series_b | ...
  companyType        String? // public | private | nonprofit | government | educational
  ownership          String? // founder-led, family, ...
  ticker             String? // Stock ticker if public
  exchange           String? // NYSE, NASDAQ, ...
  locale             String?
  timezone           String?

  // Tech stack & keywords
  technologies String[] // ["React","Stripe","AWS"]
  keywords     String[]
  tags         String[]

  // Social
  linkedinUrl   String? @db.VarChar(255)
  twitterUrl    String? @db.VarChar(255)
  facebookUrl   String? @db.VarChar(255)
  instagramUrl  String? @db.VarChar(255)
  youtubeUrl    String? @db.VarChar(255)
  githubUrl     String? @db.VarChar(255)
  crunchbaseUrl String? @db.VarChar(255)
  angellistUrl  String? @db.VarChar(255)
  blogUrl       String? @db.VarChar(255)

  // Branding
  logoUrl      String? @db.VarChar(500)
  faviconUrl   String? @db.VarChar(500)
  primaryColor String? @db.VarChar(20)

  // Address (primary HQ; additional addresses in Json)
  hqStreet      String?
  hqCity        String?
  hqRegion      String?
  hqPostalCode  String?
  hqCountry     String?
  hqCountryCode String? @db.VarChar(3)
  hqLatitude    Float?
  hqLongitude   Float?
  addresses     Json? // [{ type, street, city, region, postalCode, country }]

  // Contact info
  emailDomain  String?
  contactEmail String? @db.VarChar(255)

  // Enrichment metadata
  enrichmentMetadata Json?
  lastEnrichedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  affiliations      ContactAffiliation[]
  crmLinks          CrmCompanyLink[]
  socialLinks       CompanySocialLink[]
  customFieldValues CompanyCustomFieldValue[]

  @@index([userId])
  @@index([organizationId])
  @@index([domain])
  @@index([name])
  @@index([deletedAt])
  @@index([linkedinUrl])
  @@index([hqCountryCode])
  @@index([industry])
  @@index([employeeCountRange])
  @@index([lastEnrichedAt])
}

model ContactAffiliation {
  id          String    @id @default(uuid()) @db.Uuid
  contactId   String    @db.Uuid
  companyId   String    @db.Uuid
  role        String?
  isPrimary   Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime?
  crmMetadata Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, companyId])
  @@index([contactId])
  @@index([companyId])
}

model CrmCompanyLink {
  id              String          @id @default(uuid()) @db.Uuid
  connectionId    String          @db.Uuid
  companyId       String?         @db.Uuid
  provider        CrmProviderType
  externalId      String
  externalType    CrmRecordType
  domain          String?
  matchConfidence String          @default("domain_exact")
  lastSyncedAt    DateTime        @default(now())
  rawSnapshot     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  connection CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalType, externalId])
  @@index([companyId])
  @@index([connectionId, domain])
}

model CallerId {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  phoneNumber    String    @db.VarChar(20)
  provider       String    @default("telnyx")
  providerId     String?
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  calls        Call[]
  campaigns    Campaign[]    @relation("campaignCallerId")

  @@unique([userId, phoneNumber, deletedAt])
  @@index([userId])
  @@index([organizationId])
}

model Credit {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String?   @db.Uuid
  organizationId     String?   @db.Uuid
  amount             Float
  lastPurchaseAmount Float?
  lastPurchaseDate   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId])
  @@index([userId])
  @@index([organizationId])
}

model CreditAutoReload {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @unique @db.Uuid
  organizationId String? @unique @db.Uuid

  // Auto-reload on minimum balance
  autoReloadEnabled   Boolean @default(false)
  autoReloadThreshold Float   @default(5)
  autoReloadAmount    Float   @default(25)

  // Monthly recurring fund (Stripe subscription)
  monthlyFundEnabled   Boolean @default(false)
