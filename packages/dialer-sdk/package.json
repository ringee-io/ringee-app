{
  "name": "@ringee-io/dialer-sdk",
  "version": "0.1.0",
  "description": "Universal headless browser SDK to embed Ringee calling in any web CRM.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/ringee.global.js",
  "jsdelivr": "./dist/ringee.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ringee/dialer-core": "workspace:*"
  },
  "devDependencies": {
    "@telnyx/webrtc": "2.25.2",
    "@types/node": "~22.16.0",
    "tsup": "^8.3.0",
    "typescript": "~5.9.0",
    "vitest": "^2.1.8"
  }
}
