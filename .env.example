# ──────────────────────────────────────────────────────────────
# Ringee Environment Configuration
# Copy this file to .env and fill in your values.
#
# 🐳 Docker note: When using docker-compose.app.yml, the values
#    for DATABASE_URL, REDIS_HOST, REDIS_PORT, and REDIS_URL
#    are automatically overridden to use Docker internal hostnames.
#    You only need to set these for local (non-Docker) development.
#
# ⚠️  All apps (backend, frontend) read from this
#    single root .env. Do NOT create .env files inside sub-apps.
# ──────────────────────────────────────────────────────────────

# ── Database & Cache ──────────────────────────────────────────
DATABASE_URL="postgresql://ringee-user:ringee-password@localhost:5432/ringee-db-local?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379
REDIS_HOST="localhost"

# ── Temporal (durable background jobs) ────────────────────────
# Self-hosted Temporal frontend (plain gRPC). For local dev either run
# `docker-compose up -d` (includes ringee-temporal + UI on :8080) or
# `temporal server start-dev` (UI on :8233).
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="ringee"

# ── Auth (JWT) ────────────────────────────────────────────────
JWT_SECRET="YOUR_JWT_SECRET"
JWT_EXPIRES_IN="720h"

# ── WhatsApp ──────────────────────────────────────────────────
WHATSAPP_PHONE_ID='YOUR_WHATSAPP_PHONE_ID'
WHATSAPP_TOKEN='YOUR_WHATSAPP_TOKEN'
WHATSAPP_VERIFY_TOKEN='YOUR_WHATSAPP_VERIFY_TOKEN'
WHATSAPP_PHONE_NUMBER='YOUR_WHATSAPP_PHONE_NUMBER'

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL='http://localhost:4200'
PUBLIC_BACKEND_URL='http://localhost:3000'
BACKEND_URL='http://localhost:3000'

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY='YOUR_OPENAI_API_KEY'

# ── Anthropic (Claude) ────────────────────────────────────────
# Required only when AI_PROVIDER="anthropic".
ANTHROPIC_API_KEY='YOUR_ANTHROPIC_API_KEY'

# ── Ringee AI ─────────────────────────────────────────────────
# Selected AI provider for the Ringee AI chat: "openai" or "anthropic".
AI_PROVIDER="openai"
# OpenAI models (used when AI_PROVIDER="openai").
OPENAI_DEFAULT_MODEL="gpt-5.4-mini"
OPENAI_SUMMARY_MODEL="gpt-5.4-mini"
# Anthropic models (used when AI_PROVIDER="anthropic").
ANTHROPIC_DEFAULT_MODEL="claude-haiku-4-5"
ANTHROPIC_SUMMARY_MODEL="claude-haiku-4-5"
# Profit margin multiplier on AI token cost charged to user credits.
# 1 = bill exactly the provider cost (no margin); 1.5 = +50% margin.
AI_TOKEN_MARGIN="1"
AI_TEMPERATURE="0.4"
# Max recent messages kept in the active context window.
AI_MAX_CONTEXT_MESSAGES="20"
# Token threshold above which the orchestrator summarizes older history.
AI_SUMMARY_TRIGGER_TOKENS="6000"

# ── AI Voice Agents ──
# Margin multiplier on the voice provider's own reported cost for an agent
# conversation (voice engine + LLM tokens). 1 = bill exactly what it cost.
AI_VOICE_AGENT_PROFIT_MARGIN="1"
# The model behind each user-facing choice. "Ringee AI" runs on a model the
# voice provider hosts, so it needs no customer credential; the others are
# third-party models the customer brings their own key for.
AI_VOICE_AGENT_RINGEE_MODEL="moonshotai/Kimi-K2.6"
AI_VOICE_AGENT_OPENAI_MODEL="openai/gpt-5.2"
AI_VOICE_AGENT_ANTHROPIC_MODEL="anthropic/claude-haiku-4-5"
AI_VOICE_AGENT_GOOGLE_MODEL="google/gemini-2.5-flash"
# Hard cap on one agent call, so an unattended conversation cannot run up
# unbounded spend.
AI_VOICE_AGENT_MAX_CALL_SECONDS="900"
# How long a browser test session may keep an agent open to anonymous web calls
# before the sweep closes it again.
AI_VOICE_AGENT_TEST_SESSION_TTL_SECONDS="600"
# Region of the provider's object storage holding agent knowledge bases.
AI_VOICE_AGENT_STORAGE_REGION="us-central-1"
# Largest knowledge document a user may upload, in megabytes.
AI_VOICE_AGENT_MAX_DOCUMENT_MB="20"
# Comma-separated email allowlist for the AI Voice Agents closed beta. Only
# users whose verified Clerk email matches may open the module — everyone else
# sees the sidebar entry disabled and gets a 403 from /api/ai-voice-agents.
# Leaving this commented out keeps a committed default list (the Ringee team);
# set it to "" to lift the gate and open the module to every workspace. The
# dashboard reads the same answer through GET /api/ai-voice-agents-access, so
# the UI gate and the server guard cannot drift.
# AI_VOICE_AGENTS_BETA_EMAILS=""
# Toggle provider-side prompt caching when supported.
AI_PROMPT_CACHE_ENABLED="true"
# Full-transcript semantic extraction for Objection Intelligence.
AI_OBJECTION_AI_ENABLED="true"
# Batch AI enrichment for Follow-up Intelligence.
AI_FOLLOWUP_AI_ENABLED="true"

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM_ADDRESS="no-reply@yourdomain.com"
EMAIL_FROM_NAME="Your Name"

# ── Clerk ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='YOUR_CLERK_PUBLISHABLE_KEY'
CLERK_PUBLISHABLE_KEY='YOUR_CLERK_PUBLISHABLE_KEY'
CLERK_SECRET_KEY='YOUR_CLERK_SECRET_KEY'
CLERK_WEBHOOK_SIGNING_SECRET='YOUR_CLERK_WEBHOOK_SIGNING_SECRET'

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"

# Redirect URLs – B2B (frontend)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/auth/verify-phone"

# ── Sentry ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="YOUR_SENTRY_DSN"
NEXT_PUBLIC_SENTRY_ORG="your-org"
NEXT_PUBLIC_SENTRY_PROJECT="your-project"
SENTRY_AUTH_TOKEN="YOUR_SENTRY_AUTH_TOKEN"
NEXT_PUBLIC_SENTRY_DISABLED="true"

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
# Server-side URL for Next.js Server Components (read at runtime, NOT baked into bundle).
# In Docker, set to the internal service name: http://ringee-backend:3000/api
# docker-compose.app.yml already overrides this automatically.
API_INTERNAL_URL="http://localhost:3000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:4200"

APP_ENCRYPTION_SECRET='YOUR_APP_ENCRYPTION_SECRET'

# ── Telnyx ────────────────────────────────────────────────────
TELNYX_API_KEY='YOUR_TELNYX_API_KEY'
TELNYX_CONNECTION_ID='YOUR_TELNYX_CONNECTION_ID'
# Call Control Application used to originate calls server-side (voicemail
# drops). Telnyx → Voice → Call Control; it MUST have a webhook URL pointing at
# <BACKEND_URL>/api/call/webhook. This is a different resource from
# TELNYX_CONNECTION_ID (the Credential Connection behind WebRTC) — passing that
# one to POST /calls fails with error 10015. Leave empty only if your account
# uses the same id for both.
TELNYX_CALL_CONTROL_APP_ID=''
TELNYX_SIP_USER="YOUR_TELNYX_SIP_USER"
TELNYX_SIP_PASSWORD="YOUR_TELNYX_SIP_PASSWORD"
NEXT_PUBLIC_TELNYX_LOGIN="YOUR_TELNYX_SIP_USER"
NEXT_PUBLIC_TELNYX_PASSWORD="YOUR_TELNYX_SIP_PASSWORD"
# Multipliers applied independently to Telnyx voice and recording cost parts.
# 1 = bill provider cost; 1.5 = provider cost + 50%.
CALL_PROFIT_MARGIN="1"
CALL_RECORDING_PROFIT_MARGIN="1"
# Added to CALL_PROFIT_MARGIN when the call presented a verified caller ID.
# 0 = no surcharge, which is what was actually in effect while this was
# hard-coded. Raise it deliberately — it changes what customers are billed.
CALLER_ID_PROFIT_MARGIN_SURCHARGE="0"
# Multiplier applied to Telnyx message cost. 1 = bill provider cost.
MESSAGE_PROFIT_MARGIN="1"
# Messaging Profile linked to every number with SMS/MMS enabled. Required for
# messaging to route — Telnyx will not send/receive SMS for a number that is
# not attached to a messaging profile. Find it under Telnyx → Messaging.
TELNYX_MESSAGING_PROFILE_ID=""
# ── Desk Phones / SIP Devices ─────────────────────────────────
# Shared Outbound Voice Profile attached to every desk-phone SIP connection so
# outbound calls from physical phones bill through Ringee. Required to create
# desk phones. Find it under Telnyx → Voice → Outbound Voice Profiles.
TELNYX_OUTBOUND_VOICE_PROFILE_ID=""
# Feature flag — leave "false" to ship Desk Phones dark. Set "true" to enable
# the /api/sip-devices endpoints and the /api/webhooks/telnyx/desk-phone hook.
DESK_PHONES_ENABLED="false"
# Hard per-call ceiling (minutes) used to pre-gate desk-phone outbound spend.
DESK_PHONE_MAX_CALL_MINUTES="120"
# Shared "public" / free-trial caller ID offered when a user has no purchased
# number. Configuration, not a code literal — leave empty to require a real number.
NEXT_PUBLIC_RINGEE_PUBLIC_CALLER_ID=""
# Flat fee (USD) charged to a workspace for each caller-ID verification sent —
# covers Telnyx's per-verification charge (base + SMS/voice channel). Users
# without this much available credit cannot verify a caller ID.
CALLER_ID_VERIFICATION_FEE="1.00"
# Backend-side fallback caller ID for the browser extension's prepare-call when
# the workspace has no verified caller ID or purchased number. Optional.
RINGEE_PUBLIC_CALLER_ID=""

# ── Caller ID Rotation (Local Presence) ───────────────────────
# Health/cooling tuning for the rotation engine. All optional (sane defaults
# shown). The health job (Temporal schedule, every 30m) recomputes each pool
# number's 0-100 score from answer rate + very-short-call ratio over the window.
# A number scoring below the minimum auto-enters "cooling" for COOLING_DAYS.
CALLER_ID_HEALTH_WINDOW_DAYS="7"
CALLER_ID_HEALTH_MIN_SCORE="50"
CALLER_ID_COOLING_DAYS="3"

# ── Ringee Dialer SDK (embed in any CRM) ──────────────────────
# The SDK signs publishable keys (pk_live_…), agent session tokens and call
# correlation tokens with keys DERIVED from APP_ENCRYPTION_SECRET (scrypt with
# per-purpose salts). No extra variable is required. Set SDK_SIGNING_SECRET only
# if you want the SDK's tokens on a rotation schedule independent of
# APP_ENCRYPTION_SECRET; leaving it empty uses APP_ENCRYPTION_SECRET.
SDK_SIGNING_SECRET=""

# ── Call Recording & Transcription (Deepgram) ─────────────────
# Optional. Without DEEPGRAM_API_KEY recording works but transcription is off.
DEEPGRAM_API_KEY="YOUR_DEEPGRAM_API_KEY"
DEEPGRAM_MODEL="nova-2"
DEEPGRAM_LANGUAGE="multi"
# Credits charged per transcribed minute before margin.
TRANSCRIPTION_CREDIT_COST_PER_MINUTE="0.01"
# Profit margin multiplier for transcription billing.
TRANSCRIPTION_CREDIT_PROFIT_MARGIN="1"
# Public wss:// URL Telnyx dials for live audio. The bridge runs on the SAME
# host/port as the API at path /media-stream, so this is just your public API
# origin as wss:// + /media-stream. Locally, reuse the SAME tunnel as your
# Telnyx webhooks (the one pointing at the API port), e.g.
# wss://<your-ngrok-subdomain>.ngrok-free.app/media-stream
TRANSCRIPTION_MEDIA_STREAM_PUBLIC_URL="wss://YOUR_PUBLIC_API_HOST/media-stream"

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"
# Publishable key (pk_test_… / pk_live_…) for the Add Credits embedded checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="YOUR_STRIPE_PUBLISHABLE_KEY"
# Railway is detected automatically and its documented X-Real-IP header is used,
# so keep this at 0 there. Outside Railway, set the exact number of trusted
# reverse proxies between the internet and the API (for example 1 for Nginx).
# An incorrect value makes IP limits unreliable.
TRUST_PROXY_HOPS="0"
# Card-testing protection. Intent/session creation is allowed up to 20 times per
# account or 60 times per source IP in 10 minutes. Excess creation attempts are
# limited only until that window expires and never ban the account. Five confirmed
# card failures per account or 15 per IP trigger the stronger 24-hour abuse block.
STRIPE_ABUSE_REQUEST_WINDOW_SECONDS="600"
STRIPE_ABUSE_MAX_REQUESTS_PER_USER="20"
STRIPE_ABUSE_MAX_REQUESTS_PER_IP="60"
STRIPE_ABUSE_FAILURE_WINDOW_SECONDS="3600"
STRIPE_ABUSE_MAX_FAILURES_PER_USER="5"
STRIPE_ABUSE_MAX_FAILURES_PER_IP="15"
STRIPE_ABUSE_BLOCK_SECONDS="86400"

# ── Cloudflare R2 ─────────────────────────────────────────────
CLOUDFLARE_BUCKETNAME="YOUR_CLOUDFLARE_BUCKETNAME"
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_ACCESS_KEY="YOUR_CLOUDFLARE_ACCESS_KEY"
CLOUDFLARE_SECRET_ACCESS_KEY="YOUR_CLOUDFLARE_SECRET_ACCESS_KEY"
CLOUDFLARE_BUCKET_URL="YOUR_CLOUDFLARE_BUCKET_URL"
CLOUDFLARE_REGION="auto"
STORAGE_PROVIDER="cloudflare"

# ── Analytics & Marketing (optional) ─────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_AHREFS_KEY=
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ── Firebase Admin SDK (Backend) ─────────────────────────────
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_PRIVATE_KEY_ID="YOUR_FIREBASE_PRIVATE_KEY_ID"
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"
FIREBASE_CLIENT_EMAIL="YOUR_FIREBASE_CLIENT_EMAIL"
FIREBASE_CLIENT_ID="YOUR_FIREBASE_CLIENT_ID"
FIREBASE_CLIENT_X509_CERT_URL="YOUR_FIREBASE_CLIENT_X509_CERT_URL"

# ── Firebase Client (Frontend) ────────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your web app
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="YOUR_FIREBASE_VAPID_KEY"

# ── CRM Integrations ──────────────────────────────────────────
# Attio OAuth (register at https://app.attio.com/developer → OAuth apps)
ATTIO_OAUTH_CLIENT_ID=""
ATTIO_OAUTH_CLIENT_SECRET=""
ATTIO_OAUTH_AUTHORIZE_URL="https://app.attio.com/authorize"
ATTIO_OAUTH_TOKEN_URL="https://app.attio.com/oauth/token"
ATTIO_API_BASE_URL="https://api.attio.com"
# When true, CRM sync jobs log payloads without hitting the provider
CRM_DRY_RUN="false"
# ── Data Enrichment & Lead Search ──────────────────────────
ENRICHMENT_FEATURE_ENABLED="true"
ENRICHMENT_DRY_RUN="false"
ENRICHMENT_DEDUP_TTL_DAYS="30"
ENRICHMENT_COST_PROSPEO="5"
ENRICHMENT_COST_APOLLO="3"
ENRICHMENT_COST_LEAD_SEARCH="1"
ENRICHMENT_COST_LEAD_IMPORT="5"
PROSPEO_API_BASE_URL="https://api.prospeo.io"
APOLLO_API_BASE_URL="https://api.apollo.io"

# OpenAI Apps SDK domain verification.
# Served verbatim (text/plain) at GET /.well-known/openai-apps-challenge.
# Paste the token OpenAI's developer portal issues for your MCP hostname.
# OpenAI issues a DISTINCT token per verified origin, so the backend
# (api.ringee.io) and the ChatGPT MCP server (chatgpt.ringee.io) each use their
# own var. Leave the _CHATGPT one set on the chatgpt-app MCP deployment only.
OPENAI_APPS_CHALLENGE_TOKEN="fffffff-ffff-ffff-ffff-ffffffffffff"
OPENAI_APPS_CHALLENGE_TOKEN_CHATGPT="ffffffff-ffff-ffff-ffff-ffffffffffff"

# ── Authenticated ChatGPT MCP (OAuth) ─────────────────────────
# Used by the authenticated MCP endpoint at /api/mcp/chatgpt/sse.
# Advertised in the RFC 9728 protected-resource metadata so ChatGPT can
# discover the OAuth authorization server. Point this at your Clerk issuer
# (the auth server that mints the tokens). Comma-separated if more than one.
MCP_OAUTH_AUTHORIZATION_SERVERS="https://YOUR-CLERK-DOMAIN"
# OAuth scopes requested/advertised for the ChatGPT MCP (space/comma separated).
MCP_OAUTH_SCOPES="ringee:use"

# ── Backoffice (super admin) ──────────────────────────────────
# Comma-separated email allowlist for the internal super-admin area
# (/backoffice). Only users whose verified Clerk email matches may access it.
# REQUIRED for backoffice access: there is no built-in fallback list, so an
# unset value means nobody has backoffice access in this deployment. The
# dashboard reads the same allowlist through GET /api/backoffice/access, so the
# UI gate and the server guard cannot drift.
BACKOFFICE_SUPER_ADMIN_EMAILS=""

# ── TriggerLoop (internal workflow engine) ────────────────────
# One shared key, used in both directions: this backend sends it as
# `Authorization: Bearer` when calling TriggerLoop, and TriggerLoop sends it
# back in the `x-triggerloop-api-key` header on every call to
# POST /api/internal/triggerloop/webhook.
# REQUIRED when TriggerLoop is enabled: that endpoint executes actions (email,
# push, task creation) and its guard fails closed, rejecting every request
# while this is unset. The same value must be set as TRIGGERLOOP_API_KEY in
# TriggerLoop, whose seed writes it into the project's authConfig.
TRIGGERLOOP_API_KEY=""
TRIGGERLOOP_BASE_URL=""
TRIGGERLOOP_PROJECT_KEY="ringee"

# ── Internal notifications ────────────────────────────────────
# Where free-trial / credit requests are emailed for manual review. Defaults to
# EMAIL_FROM_ADDRESS. Set this if you self-host, or those requests go to the
# address configured as your sender.
RINGEE_TEAM_EMAIL=""

# ── Trustpilot review invitations (optional) ──────────────────
# Trustpilot's BCC invitation address for this domain. Ringee blind-copies it on
# the welcome email a customer gets the first time they subscribe to the
# Organization plan, which makes Trustpilot invite that customer to review us.
# Leave empty to send that email without triggering any invitation.
TRUSTPILOT_INVITE_BCC_EMAIL=""

# ── Calendar OAuth (optional) ─────────────────────────────────
# Google / Microsoft calendar integration. When unset the feature reports a
# clear error instead of failing at boot.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
MICROSOFT_CALENDAR_CLIENT_ID=""
MICROSOFT_CALENDAR_CLIENT_SECRET=""
