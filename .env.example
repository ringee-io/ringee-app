# ──────────────────────────────────────────────────────────────
# Ringee Environment Configuration
# Copy this file to .env and fill in your values.
#
# 🐳 Docker note: When using docker-compose.app.yml, the values
#    for DATABASE_URL, REDIS_HOST, REDIS_PORT, and REDIS_URL
#    are automatically overridden to use Docker internal hostnames.
#    You only need to set these for local (non-Docker) development.
#
# ⚠️  All apps (backend, frontend) read from this
#    single root .env. Do NOT create .env files inside sub-apps.
# ──────────────────────────────────────────────────────────────

# ── Database & Cache ──────────────────────────────────────────
DATABASE_URL="postgresql://ringee-user:ringee-password@localhost:5432/ringee-db-local?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379
REDIS_HOST="localhost"

# ── Auth (JWT) ────────────────────────────────────────────────
JWT_SECRET="YOUR_JWT_SECRET"
JWT_EXPIRES_IN="720h"

# ── WhatsApp ──────────────────────────────────────────────────
WHATSAPP_PHONE_ID='YOUR_WHATSAPP_PHONE_ID'
WHATSAPP_TOKEN='YOUR_WHATSAPP_TOKEN'
WHATSAPP_VERIFY_TOKEN='YOUR_WHATSAPP_VERIFY_TOKEN'
WHATSAPP_PHONE_NUMBER='YOUR_WHATSAPP_PHONE_NUMBER'

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL='http://localhost:4200'
PUBLIC_BACKEND_URL='http://localhost:3000'
BACKEND_URL='http://localhost:3000'

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY='YOUR_OPENAI_API_KEY'

# ── Anthropic (Claude) ────────────────────────────────────────
# Required only when AI_PROVIDER="anthropic".
ANTHROPIC_API_KEY='YOUR_ANTHROPIC_API_KEY'

# ── Ringee AI ─────────────────────────────────────────────────
# Selected AI provider for the Ringee AI chat: "openai" or "anthropic".
AI_PROVIDER="openai"
# OpenAI models (used when AI_PROVIDER="openai").
OPENAI_DEFAULT_MODEL="gpt-5.4-mini"
OPENAI_SUMMARY_MODEL="gpt-5.4-mini"
# Anthropic models (used when AI_PROVIDER="anthropic").
ANTHROPIC_DEFAULT_MODEL="claude-haiku-4-5"
ANTHROPIC_SUMMARY_MODEL="claude-haiku-4-5"
# Profit margin multiplier on AI token cost charged to user credits.
# 1 = bill exactly the provider cost (no margin); 1.5 = +50% margin.
AI_TOKEN_MARGIN="1"
AI_TEMPERATURE="0.4"
# Max recent messages kept in the active context window.
AI_MAX_CONTEXT_MESSAGES="20"
# Token threshold above which the orchestrator summarizes older history.
AI_SUMMARY_TRIGGER_TOKENS="6000"
# Toggle provider-side prompt caching when supported.
AI_PROMPT_CACHE_ENABLED="true"

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM_ADDRESS="no-reply@yourdomain.com"
EMAIL_FROM_NAME="Your Name"

# ── Clerk ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY='YOUR_CLERK_PUBLISHABLE_KEY'
CLERK_PUBLISHABLE_KEY='YOUR_CLERK_PUBLISHABLE_KEY'
CLERK_SECRET_KEY='YOUR_CLERK_SECRET_KEY'
CLERK_WEBHOOK_SIGNING_SECRET='YOUR_CLERK_WEBHOOK_SIGNING_SECRET'

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"

# Redirect URLs – B2B (frontend)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard/overview"

# ── Sentry ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="YOUR_SENTRY_DSN"
NEXT_PUBLIC_SENTRY_ORG="your-org"
NEXT_PUBLIC_SENTRY_PROJECT="your-project"
SENTRY_AUTH_TOKEN="YOUR_SENTRY_AUTH_TOKEN"
NEXT_PUBLIC_SENTRY_DISABLED="true"

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
# Server-side URL for Next.js Server Components (read at runtime, NOT baked into bundle).
# In Docker, set to the internal service name: http://ringee-backend:3000/api
# docker-compose.app.yml already overrides this automatically.
API_INTERNAL_URL="http://localhost:3000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:4200"

APP_ENCRYPTION_SECRET='YOUR_APP_ENCRYPTION_SECRET'

# ── Telnyx ────────────────────────────────────────────────────
TELNYX_API_KEY='YOUR_TELNYX_API_KEY'
TELNYX_CONNECTION_ID='YOUR_TELNYX_CONNECTION_ID'
TELNYX_SIP_USER="YOUR_TELNYX_SIP_USER"
TELNYX_SIP_PASSWORD="YOUR_TELNYX_SIP_PASSWORD"
NEXT_PUBLIC_TELNYX_LOGIN="YOUR_TELNYX_SIP_USER"
NEXT_PUBLIC_TELNYX_PASSWORD="YOUR_TELNYX_SIP_PASSWORD"

# ── Call Recording & Transcription (Deepgram) ─────────────────
# Optional. Without DEEPGRAM_API_KEY recording works but transcription is off.
DEEPGRAM_API_KEY="YOUR_DEEPGRAM_API_KEY"
DEEPGRAM_MODEL="nova-2"
DEEPGRAM_LANGUAGE="multi"
# Credits charged per transcribed minute before margin.
TRANSCRIPTION_CREDIT_COST_PER_MINUTE="0.01"
# Profit margin multiplier for transcription billing.
TRANSCRIPTION_CREDIT_PROFIT_MARGIN="1"
# Public wss:// URL Telnyx dials for live audio. The bridge runs on the SAME
# host/port as the API at path /media-stream, so this is just your public API
# origin as wss:// + /media-stream. Locally, reuse the SAME tunnel as your
# Telnyx webhooks (the one pointing at the API port), e.g.
# wss://<your-ngrok-subdomain>.ngrok-free.app/media-stream
TRANSCRIPTION_MEDIA_STREAM_PUBLIC_URL="wss://YOUR_PUBLIC_API_HOST/media-stream"

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# ── Cloudflare R2 ─────────────────────────────────────────────
CLOUDFLARE_BUCKETNAME="YOUR_CLOUDFLARE_BUCKETNAME"
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_ACCESS_KEY="YOUR_CLOUDFLARE_ACCESS_KEY"
CLOUDFLARE_SECRET_ACCESS_KEY="YOUR_CLOUDFLARE_SECRET_ACCESS_KEY"
CLOUDFLARE_BUCKET_URL="YOUR_CLOUDFLARE_BUCKET_URL"
CLOUDFLARE_REGION="auto"
STORAGE_PROVIDER="cloudflare"

# ── Analytics & Marketing (optional) ─────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_AHREFS_KEY=
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ── Firebase Admin SDK (Backend) ─────────────────────────────
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIREBASE_PRIVATE_KEY_ID="YOUR_FIREBASE_PRIVATE_KEY_ID"
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"
FIREBASE_CLIENT_EMAIL="YOUR_FIREBASE_CLIENT_EMAIL"
FIREBASE_CLIENT_ID="YOUR_FIREBASE_CLIENT_ID"
FIREBASE_CLIENT_X509_CERT_URL="YOUR_FIREBASE_CLIENT_X509_CERT_URL"

# ── Firebase Client (Frontend) ────────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your web app
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="YOUR_FIREBASE_VAPID_KEY"

# ── CRM Integrations ──────────────────────────────────────────
# Attio OAuth (register at https://app.attio.com/developer → OAuth apps)
ATTIO_OAUTH_CLIENT_ID=""
ATTIO_OAUTH_CLIENT_SECRET=""
ATTIO_OAUTH_AUTHORIZE_URL="https://app.attio.com/authorize"
ATTIO_OAUTH_TOKEN_URL="https://app.attio.com/oauth/token"
ATTIO_API_BASE_URL="https://api.attio.com"
# When true, CRM sync jobs log payloads without hitting the provider
CRM_DRY_RUN="false"
# ── Data Enrichment & Lead Search ──────────────────────────
ENRICHMENT_FEATURE_ENABLED="true"
ENRICHMENT_DRY_RUN="false"
ENRICHMENT_DEDUP_TTL_DAYS="30"
ENRICHMENT_COST_PROSPEO="5"
ENRICHMENT_COST_APOLLO="3"
ENRICHMENT_COST_LEAD_SEARCH="1"
ENRICHMENT_COST_LEAD_IMPORT="5"
PROSPEO_API_BASE_URL="https://api.prospeo.io"
APOLLO_API_BASE_URL="https://api.apollo.io"

# OpenAI Apps SDK domain verification.
# Served verbatim (text/plain) at GET /.well-known/openai-apps-challenge.
# Paste the token OpenAI's developer portal issues for your MCP hostname.
# OpenAI issues a DISTINCT token per verified origin, so the backend
# (api.ringee.io) and the ChatGPT MCP server (chatgpt.ringee.io) each use their
# own var. Leave the _CHATGPT one set on the chatgpt-app MCP deployment only.
OPENAI_APPS_CHALLENGE_TOKEN="fffffff-ffff-ffff-ffff-ffffffffffff"
OPENAI_APPS_CHALLENGE_TOKEN_CHATGPT="ffffffff-ffff-ffff-ffff-ffffffffffff"

# ── Authenticated ChatGPT MCP (OAuth) ─────────────────────────
# Used by the authenticated MCP endpoint at /api/mcp/chatgpt/sse.
# Advertised in the RFC 9728 protected-resource metadata so ChatGPT can
# discover the OAuth authorization server. Point this at your Clerk issuer
# (the auth server that mints the tokens). Comma-separated if more than one.
MCP_OAUTH_AUTHORIZATION_SERVERS="https://YOUR-CLERK-DOMAIN"
# OAuth scopes requested/advertised for the ChatGPT MCP (space/comma separated).
MCP_OAUTH_SCOPES="ringee:use"
